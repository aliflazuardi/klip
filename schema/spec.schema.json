{
  "$defs": {
    "Beat": {
      "additionalProperties": false,
      "description": "A new shot inside a stock scene, cut in on a narration word with its own clip.",
      "properties": {
        "at": {
          "description": "Narration word (or phrase; its first word counts) where this shot starts: the cut lands as the voice says it.",
          "minLength": 1,
          "title": "At",
          "type": "string"
        },
        "query": {
          "description": "English keywords for this shot's stock clip.",
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "at",
        "query"
      ],
      "title": "Beat",
      "type": "object"
    },
    "ChartBand": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "description": "First x value of the shaded span (same form as the data's x).",
          "minLength": 1,
          "title": "Start",
          "type": "string"
        },
        "end": {
          "description": "Last x value of the span.",
          "minLength": 1,
          "title": "End",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short text in the band, e.g. 'SBY'.",
          "title": "Label"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "ChartBand",
      "type": "object"
    },
    "ChartPoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "description": "X value as shown/compared: an ISO date ('2024-10-16') or a label ('2019').",
          "minLength": 1,
          "title": "X",
          "type": "string"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "ChartPoint",
      "type": "object"
    },
    "Compare": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "$ref": "#/$defs/Side"
        },
        "right": {
          "$ref": "#/$defs/Side"
        }
      },
      "required": [
        "left",
        "right"
      ],
      "title": "Compare",
      "type": "object"
    },
    "Cover": {
      "additionalProperties": false,
      "properties": {
        "lines": {
          "description": "Title as 2-3 explicit lines; the last line is the keyword (bigger, accent colour). Use this or title + keyword.",
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Lines",
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Title lead-in (3-5 words, wraps to max 2 lines), e.g. 'Kenapa Kita Ikut Ikutan'.",
          "title": "Title"
        },
        "keyword": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The payoff word(s) shown big as the last line, e.g. 'Menguap?'.",
          "title": "Keyword"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One short sentence under the title, e.g. 'Ternyata bukan karena bosan'.",
          "title": "Subtitle"
        }
      },
      "title": "Cover",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "claim",
        "source"
      ],
      "title": "Fact",
      "type": "object"
    },
    "HookVariant": {
      "additionalProperties": false,
      "description": "An alternative first scene for A/B testing; unset fields keep the main hook's.",
      "properties": {
        "narration": {
          "minLength": 1,
          "title": "Narration",
          "type": "string"
        },
        "on_screen_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Screen Text"
        },
        "tts_override": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tts Override"
        },
        "visual": {
          "anyOf": [
            {
              "$ref": "#/$defs/Visual"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "emphasis": {
          "items": {
            "type": "string"
          },
          "title": "Emphasis",
          "type": "array"
        }
      },
      "required": [
        "narration"
      ],
      "title": "HookVariant",
      "type": "object"
    },
    "MotionStep": {
      "additionalProperties": false,
      "description": "One beat of a motion component (see StageElement.steps).",
      "properties": {
        "text": {
          "description": "kinetic: the phrase; split/flow/funnel: the part's name; meter: a short caption for this level; cycle: the step; timeline: the event; reel: an option.",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Narration word where this step plays (after the element's own `at`, in order). Unset = shortly after the previous step.",
          "title": "At"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "split/flow/funnel: the amount (sizes the part); meter: the fill level (≤ the element's `max`).",
          "title": "Value"
        },
        "show": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The value as shown, e.g. 'Rp96rb', '96%', '1,2 jt'; counts up when it's a number. Unset: split shows the share in %, flow/funnel the plain value.",
          "title": "Show"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "timeline: the date ('2014', 'Mar 2020'); others: a small line under the step.",
          "title": "Label"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lucide icon for the step (flow/cycle/timeline/funnel nodes).",
          "title": "Name"
        },
        "accent": {
          "default": false,
          "description": "Highlight this step (kinetic phrase, split/flow part, funnel layer); reel: the option the reel lands on (exactly one).",
          "title": "Accent",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "MotionStep",
      "type": "object"
    },
    "Music": {
      "additionalProperties": false,
      "properties": {
        "mood": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "calm",
          "description": "Picks a track from assets/music/<mood>/; null = no music.",
          "title": "Mood"
        },
        "track": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Explicit track path (overrides mood).",
          "title": "Track"
        }
      },
      "title": "Music",
      "type": "object"
    },
    "Post": {
      "additionalProperties": false,
      "properties": {
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        },
        "hashtags": {
          "items": {
            "type": "string"
          },
          "title": "Hashtags",
          "type": "array"
        }
      },
      "title": "Post",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "template": {
          "enum": [
            "hook",
            "explain",
            "list_item",
            "myth_fact",
            "stat",
            "compare",
            "cta"
          ],
          "title": "Template",
          "type": "string"
        },
        "narration": {
          "description": "Spoken text; also what captions display.",
          "minLength": 1,
          "title": "Narration",
          "type": "string"
        },
        "tts_override": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional spoken version, e.g. 'wai fai' for 'WiFi'.",
          "title": "Tts Override"
        },
        "on_screen_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Screen Text"
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "emphasis": {
          "description": "Words/phrases to color with the emphasis color.",
          "items": {
            "type": "string"
          },
          "title": "Emphasis",
          "type": "array"
        },
        "delivery": {
          "anyOf": [
            {
              "enum": [
                "neutral",
                "energetic",
                "emphatic",
                "warm",
                "calm"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Voice style for this scene (rate/pitch preset in klip.yaml prosody); unset = by template.",
          "title": "Delivery"
        },
        "list_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "list_item: number shown; auto-numbered if unset.",
          "title": "List Index"
        },
        "list_total": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "list_item: total shown ('1/3'); auto if unset.",
          "title": "List Total"
        },
        "myth": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "myth_fact: the myth (short).",
          "title": "Myth"
        },
        "fact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "myth_fact: the fact (short).",
          "title": "Fact"
        },
        "reveal_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "myth_fact: narration word at which the fact card appears (default: ~45% into the scene).",
          "title": "Reveal At"
        },
        "stat": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stat"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "compare": {
          "anyOf": [
            {
              "$ref": "#/$defs/Compare"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cta_type": {
          "anyOf": [
            {
              "enum": [
                "follow",
                "save",
                "comment",
                "share"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cta: what the outro asks for; shows an action chip (icon + label). 'comment' = on_screen_text is a two-sided question shown as the headline.",
          "title": "Cta Type"
        }
      },
      "required": [
        "id",
        "template",
        "narration"
      ],
      "title": "Scene",
      "type": "object"
    },
    "Side": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "Column title, e.g. 'Power nap'.",
          "title": "Label",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One short line under the title.",
          "title": "Text"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lucide icon name.",
          "title": "Icon"
        }
      },
      "required": [
        "label"
      ],
      "title": "Side",
      "type": "object"
    },
    "StageBar": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "Bar label under the bar, e.g. '2023'.",
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "description": "Bar height (bars are scaled to the largest).",
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Value shown on top of the bar, e.g. 'Rp12rb'; unset = no text.",
          "title": "Text"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "StageBar",
      "type": "object"
    },
    "StageElement": {
      "additionalProperties": false,
      "description": "A prop that builds up on a stage scene: it pops in as the voice says `at` and stays.",
      "properties": {
        "at": {
          "description": "Narration word (or phrase; its first word counts) where this element pops in. Elements are matched in narration order.",
          "minLength": 1,
          "title": "At",
          "type": "string"
        },
        "kind": {
          "description": "cutout = stock photo with its background removed (a sticker); photo = photo card; icon = Lucide icon on a sticker disc; label = paper tag; number = big number; bar = bar chart; stack = a pile of `count` icons; highlight = yellow box around an earlier element; stamp = a rubber stamp that thumps down (a verdict: 'BERHASIL', 'PALSU'); chart = a line chart that draws on (real data: points, csv or ticker); unit = a grid of `total` squares, `filled` of them highlighted; person = a real person's card (Wikipedia photo of `who`, name, a line, a stat); news = a headline card (outlet, date, text); logo = an organisation's logo (`who`) on a sign; screenshot = a web page (`url`) in a browser window. Motion components (animated diagrams; their `steps` play on their own words): kinetic = big kinetic type, one phrase per step; split = a whole that breaks into shares (step values); flow = amounts flowing from a source (`text`, `name`) to 1-4 destinations; meter = a gauge filling to each step's value out of `max`, with a counter; cycle = a loop of 3-6 steps with a dot going round (a vicious circle); timeline = dated events (step `label` = the date); funnel = layers narrowing step by step; reel = a slot reel spinning through options and landing on the `accent` one.",
          "enum": [
            "cutout",
            "photo",
            "icon",
            "label",
            "number",
            "bar",
            "stack",
            "highlight",
            "stamp",
            "chart",
            "unit",
            "person",
            "news",
            "logo",
            "screenshot",
            "kinetic",
            "split",
            "flow",
            "meter",
            "cycle",
            "timeline",
            "funnel",
            "reel"
          ],
          "title": "Kind",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cutout/photo: English keywords for the stock photo, naming one object or person (e.g. 'tempeh block', 'businessman shrugging').",
          "title": "Query"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cutout/photo/person/logo: your own image instead of `query` / `who` (a transparent PNG is used as-is).",
          "title": "Path"
        },
        "who": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "person/logo/cutout/photo: the Wikipedia article title of a real person or organisation (e.g. 'Joko Widodo', 'SoftBank Group'); its lead image is used, with the licence in the credits.",
          "title": "Who"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "icon/stack: Lucide icon name, e.g. 'coins'. cutout/photo: an icon shown instead when no photo is found. flow/meter: the source / gauge icon.",
          "title": "Name"
        },
        "brief": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cutout/photo/person/logo: the ideal photo in a few words, in Indonesian, for the photo brief the user may shoot or find ('tangan memegang HP dengan aplikasi slot, malam hari').",
          "title": "Brief"
        },
        "own": {
          "default": false,
          "description": "cutout/photo/person/logo: this prop must be exactly right (a local product, a specific place): always listed in the photo brief; stock is only a placeholder until the user's photo is in the photo folder.",
          "title": "Own",
          "type": "boolean"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "label: the tag text (1-4 words); number: the number as shown, e.g. '-7%' or 'Rp12.000'; stamp: 1-2 words; chart: its title ('IHSG'); unit: the legend ('1 kotak = 1.000 alat'); person: one small line ('2014–2024'); news: the headline; flow: the source ('Rp100rb'); meter: what's measured ('Uang hilang'); cycle: the centre; split/reel/funnel: an optional title.",
          "title": "Text"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cutout/photo/icon/logo/screenshot: a short tag stuck under the element; person: the name (default: from `who`).",
          "title": "Label"
        },
        "tone": {
          "default": "neutral",
          "description": "number/stamp/person stat/chart line: colour (up = green, down = red; a neutral chart follows its trend).",
          "enum": [
            "up",
            "down",
            "neutral"
          ],
          "title": "Tone",
          "type": "string"
        },
        "points": {
          "description": "chart: inline data.",
          "items": {
            "$ref": "#/$defs/ChartPoint"
          },
          "maxItems": 400,
          "title": "Points",
          "type": "array"
        },
        "csv": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "chart: repo-relative CSV with a header; first column x, second y.",
          "title": "Csv"
        },
        "ticker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "chart: a Yahoo Finance symbol, e.g. '^JKSE' (IHSG), 'BBCA.JK', 'IDR=X' (USD/IDR); needs `start`.",
          "title": "Ticker"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "chart ticker: first date, YYYY-MM-DD.",
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "chart ticker: last date, YYYY-MM-DD (unset = today).",
          "title": "End"
        },
        "bands": {
          "description": "chart: shaded spans with a label (eras, terms of office).",
          "items": {
            "$ref": "#/$defs/ChartBand"
          },
          "maxItems": 6,
          "title": "Bands",
          "type": "array"
        },
        "total": {
          "anyOf": [
            {
              "maximum": 400,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "unit: how many squares.",
          "title": "Total"
        },
        "filled": {
          "anyOf": [
            {
              "maximum": 400,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "unit: how many are highlighted (default all).",
          "title": "Filled"
        },
        "outlet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "news: the outlet, e.g. 'Katadata'.",
          "title": "Outlet"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "news: the date as shown, e.g. 'Jumat, 16 Okt 2026'.",
          "title": "Date"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "screenshot: the page to capture (http/https).",
          "title": "Url"
        },
        "wayback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "screenshot: capture the Wayback Machine copy from this date (YYYY or YYYYMMDD), for pages as they looked back then.",
          "title": "Wayback"
        },
        "selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "screenshot: CSS selector of the part to capture (unset = the top of the page).",
          "title": "Selector"
        },
        "stat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "person: a short stat under the name, e.g. '+499,50%'.",
          "title": "Stat"
        },
        "bars": {
          "description": "bar: 2-4 bars, left to right.",
          "items": {
            "$ref": "#/$defs/StageBar"
          },
          "maxItems": 4,
          "title": "Bars",
          "type": "array"
        },
        "steps": {
          "description": "Motion components: the beats, in narration order.",
          "items": {
            "$ref": "#/$defs/MotionStep"
          },
          "maxItems": 10,
          "title": "Steps",
          "type": "array"
        },
        "max": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "meter: the full-scale value.",
          "title": "Max"
        },
        "count": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "stack: how many icons pile up (default 4).",
          "title": "Count"
        },
        "target": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "highlight: number (1-based) of the earlier element in this scene to box.",
          "title": "Target"
        },
        "pos": {
          "anyOf": [
            {
              "enum": [
                "tl",
                "tc",
                "tr",
                "ml",
                "mc",
                "mr",
                "bl",
                "bc",
                "br"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Slot on the stage: t/m/b (top/middle/bottom) + l/c/r. Unset = automatic layout.",
          "title": "Pos"
        },
        "size": {
          "anyOf": [
            {
              "enum": [
                "s",
                "m",
                "l"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unset = by how many elements share the stage.",
          "title": "Size"
        },
        "clear": {
          "default": false,
          "description": "Clear the stage (earlier elements leave) before this one enters.",
          "title": "Clear",
          "type": "boolean"
        }
      },
      "required": [
        "at",
        "kind"
      ],
      "title": "StageElement",
      "type": "object"
    },
    "Stat": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "description": "Number the counter animates to, e.g. 34 or 1.5.",
          "title": "Value",
          "type": "number"
        },
        "prefix": {
          "default": "",
          "description": "Shown before the number, e.g. 'Rp'.",
          "title": "Prefix",
          "type": "string"
        },
        "suffix": {
          "default": "",
          "description": "Shown after the number, e.g. '%' or ' menit'.",
          "title": "Suffix",
          "type": "string"
        },
        "decimals": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Line under the number; defaults to on_screen_text.",
          "title": "Label"
        }
      },
      "required": [
        "value"
      ],
      "title": "Stat",
      "type": "object"
    },
    "Visual": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "default": "solid",
          "enum": [
            "stock_video",
            "stock_photo",
            "ai_image",
            "icon",
            "solid",
            "local",
            "stage"
          ],
          "title": "Type",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "English keywords for stock search (the scene's first shot).",
          "title": "Query"
        },
        "beats": {
          "description": "Later shots of this scene, in narration order, each cut in on a word with its own clip. Preferred over `queries`.",
          "items": {
            "$ref": "#/$defs/Beat"
          },
          "maxItems": 5,
          "title": "Beats",
          "type": "array"
        },
        "queries": {
          "description": "Legacy: extra English queries for later shots, cut on a timer. Use `beats` instead.",
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Queries",
          "type": "array"
        },
        "max_shots": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cap the cuts in this scene; 1 = a single shot.",
          "title": "Max Shots"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lucide icon name, e.g. 'brain'.",
          "title": "Name"
        },
        "bg": {
          "default": "gradient",
          "enum": [
            "solid",
            "gradient"
          ],
          "title": "Bg",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local clip/photo path (type=local).",
          "title": "Path"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Image prompt (type=ai_image).",
          "title": "Prompt"
        },
        "background": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "type=stage: 'grid' (dot-grid paper), 'studio' (wall over a light desk), 'spotlight' (dark desk under a light), or the older 'desk', 'paper', 'kraft', 'board' (see klip.yaml stage.backgrounds), or a repo-relative image path. Unset = stage.default_background.",
          "title": "Background"
        },
        "elements": {
          "description": "type=stage: props that build up on the background, each popping in on its narration word, in narration order.",
          "items": {
            "$ref": "#/$defs/StageElement"
          },
          "maxItems": 12,
          "title": "Elements",
          "type": "array"
        }
      },
      "title": "Visual",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "slug": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Slug",
      "type": "string"
    },
    "language": {
      "default": "id-ID",
      "title": "Language",
      "type": "string"
    },
    "voice": {
      "default": "female",
      "enum": [
        "male",
        "female"
      ],
      "title": "Voice",
      "type": "string"
    },
    "speech_rate": {
      "anyOf": [
        {
          "pattern": "^[+-]\\d{1,3}%$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "e.g. '+8%'. Unset = per-voice default in klip.yaml.",
      "title": "Speech Rate"
    },
    "target_duration_s": {
      "default": 45,
      "maximum": 120,
      "minimum": 10,
      "title": "Target Duration S",
      "type": "integer"
    },
    "style": {
      "default": "default",
      "title": "Style",
      "type": "string"
    },
    "series": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Series key, e.g. 'kenapa'; shown as a pill (label from the style's series_pill.labels, else the key in capitals).",
      "title": "Series"
    },
    "episode": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Episode number shown on the series pill ('#12').",
      "title": "Episode"
    },
    "look": {
      "default": "mixed",
      "description": "'stage' = illustrated explainer look: most hook/explain/list_item scenes use visual.type 'stage' (share in klip.yaml stage.look_min_share). 'mixed' = pick per scene.",
      "enum": [
        "mixed",
        "stage"
      ],
      "title": "Look",
      "type": "string"
    },
    "progress_bar": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Thin progress bar at the top; unset = the style's setting. Set false/true to A/B test it.",
      "title": "Progress Bar"
    },
    "save_nudge": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "'Simpan dulu' pill when the 2nd list_item starts; unset = the style's save_nudge.enabled.",
      "title": "Save Nudge"
    },
    "music": {
      "$ref": "#/$defs/Music"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "post": {
      "$ref": "#/$defs/Post"
    },
    "cover": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cover"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Designed cover.png (profile grid thumbnail); unset = built from the hook's on_screen_text (emphasised end = keyword)."
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    },
    "sfx": {
      "default": true,
      "description": "Sound effects on cuts, reveals, badges (see klip.yaml sfx).",
      "title": "Sfx",
      "type": "boolean"
    },
    "hook_variants": {
      "description": "Alternative hooks (scene 1) for A/B testing; `klip render --variants` renders each.",
      "items": {
        "$ref": "#/$defs/HookVariant"
      },
      "maxItems": 4,
      "title": "Hook Variants",
      "type": "array"
    }
  },
  "required": [
    "slug",
    "scenes"
  ],
  "title": "Klip scene spec",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
