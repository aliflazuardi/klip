<!doctype html>
<html lang="id" data-resolution="portrait">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=1080, height=1920" />
<title>{{ slug }}</title>
<script src="gsap.min.js"></script>
{% if code and code.three %}<script src="three.min.js"></script>{% endif %}
<style>
{% for weight, file in font_files.items() %}
@font-face { font-family: "{{ style.font_family }}"; font-weight: {{ weight }}; src: url("fonts/{{ file }}") format("woff2"); }
{% endfor %}
{% if code %}
{% for f in code.faces %}
@font-face { font-family: "{{ f.family }}"; font-weight: {{ f.weight }}; font-style: {{ f.style }}; src: url("fonts/{{ f.file }}") format("woff2"); }
{% endfor %}
{% endif %}
:root {
{% if code %}  {{ code.vars }}
{% endif %}
  --text: {{ style.text_color }};
  --accent: {{ style.accent_color }};
  --emph: {{ style.emphasis_color }};
  --stroke: {{ style.stroke_color }};
  --shade: {{ style.shade_color }};
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { width: 1080px; height: 1920px; overflow: hidden; background: #000; }
#root { position: relative; width: 1080px; height: 1920px; overflow: hidden;
        font-family: "{{ style.font_family }}", system-ui, sans-serif; color: var(--text); }

/* B-roll layer (root-level clips so the runtime controls playback), under the scene overlays */
.media { position: absolute; left: 0; top: 0; width: 1080px; height: 1920px; object-fit: cover; z-index: 0; }

/* Scenes */
.scene { position: absolute; inset: 0; overflow: hidden; z-index: 1; }
/* Wrapper for a scene's text/cards: drifts slowly so no scene is ever a still frame. */
.scene .content { position: absolute; inset: 0; }
.scene .bg { position: absolute; inset: 0; background: linear-gradient(160deg, var(--c1) 0%, var(--c2) 100%); }
.scene .blob { position: absolute; border-radius: 50%; filter: blur(90px); opacity: .45; }
.scene .b1 { width: 760px; height: 760px; left: -220px; top: 120px; background: var(--c2); }
.scene .b2 { width: 640px; height: 640px; right: -200px; top: 980px; background: var(--c1); opacity: .6; }
.scene .grain { position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 35%, rgba(255,255,255,.10), rgba(0,0,0,.35) 75%); }
/* Over b-roll: drop the gradient card, darken for readability (heavier behind headline + captions) */
.scene.has-media .bg { background:
    linear-gradient(180deg, {{ style.shade_color | rgba(0.65) }} 0%, {{ style.shade_color | rgba(0) }} 30%, {{ style.shade_color | rgba(0) }} 52%, {{ style.shade_color | rgba(0.70) }} 72%, {{ style.shade_color | rgba(0.55) }} 100%),
    {{ style.shade_color | rgba(style.media_dim) }}; }
.scene.has-media .blob, .scene.has-media .grain { display: none; }

/* Safe zone: x 60–960, y 220–1450 */
.safe { position: absolute; left: 60px; width: 900px; }
.headline { font-size: {{ style.headline.font_size }}px; font-weight: {{ style.headline.font_weight }};
            line-height: 1.08; letter-spacing: -0.02em; text-align: center;
            text-shadow: 0 8px 32px rgba(0,0,0,.45); }
.headline .hw { display: inline-block; }
.headline .hw.emph { color: var(--accent); }
.iconwrap { position: absolute; left: 50%; display: flex; align-items: center; justify-content: center;
            border-radius: 50%; background: rgba(255,255,255,.12); border: 3px solid rgba(255,255,255,.25); }
.iconwrap svg { width: 58%; height: 58%; stroke: var(--text); stroke-width: 1.6; }

/* list_item */
.numrow { position: absolute; left: 60px; width: 900px; display: flex; justify-content: center; }
.numpill { display: inline-flex; align-items: baseline; gap: 6px; padding: 6px 54px 14px; border-radius: 999px;
           background: var(--accent); color: var(--stroke); box-shadow: 0 16px 48px rgba(0,0,0,.35); }
.numpill .n { font-size: 170px; font-weight: 800; line-height: 1; }
.numpill .t { font-size: 72px; font-weight: 800; opacity: .65; }

/* myth_fact */
.mf { position: absolute; left: 60px; width: 900px; padding: 34px 40px 40px; border-radius: 36px;
      background: {{ style.shade_color | rgba(0.62) }}; border-left: 14px solid var(--mfc); box-shadow: 0 18px 50px rgba(0,0,0,.35); }
.mf.myth { --mfc: {{ style.myth_color }}; }
.mf.fact { --mfc: {{ style.fact_color }}; }
.mf-tag { display: inline-flex; align-items: center; gap: 14px; padding: 8px 26px 8px 14px; border-radius: 999px;
          background: var(--mfc); font-size: 44px; font-weight: 800; letter-spacing: .06em; }
.mf-tag svg { width: 46px; height: 46px; stroke: #fff; stroke-width: 3.2; }
.mf-text { display: block; margin-top: 22px; font-size: 64px; font-weight: 800; line-height: 1.15; }
/* strike-through drawn per line: background on an inline span, cloned onto every line box */
.mf-strike { background-image: linear-gradient({{ style.myth_color }}, {{ style.myth_color }}); background-repeat: no-repeat;
             background-position: 0 58%; background-size: 0% 10px;
             -webkit-box-decoration-break: clone; box-decoration-break: clone; }

/* stat */
.statrow { position: absolute; left: 60px; width: 900px; display: flex; flex-wrap: wrap; justify-content: center;
           align-items: baseline; color: var(--accent); font-weight: 800; letter-spacing: -0.03em;
           text-shadow: 0 12px 40px rgba(0,0,0,.45); font-variant-numeric: tabular-nums; }
.statrow .pre, .statrow .suf { font-size: 110px; }
.statrow .suf.spaced { margin-left: 24px; }

/* compare */
.cmp-stack { position: absolute; left: 60px; width: 900px; display: flex; flex-direction: column; gap: 110px; }
.cmp { position: relative; width: 900px; display: flex; gap: 40px; margin-top: 70px; }
.cmp-stack .headline + .cmp { margin-top: 0; }
.cmp-col { flex: 1; min-height: 560px; padding: 52px 28px 40px; border-radius: 36px; text-align: center;
           background: {{ style.shade_color | rgba(0.58) }}; border-top: 12px solid var(--cc); box-shadow: 0 18px 50px rgba(0,0,0,.35);
           display: flex; flex-direction: column; align-items: center; gap: 22px; }
.cmp-col.left { --cc: var(--emph); }
.cmp-col.right { --cc: var(--accent); }
.cmp-ic svg { width: 130px; height: 130px; stroke: var(--cc); stroke-width: 1.7; }
.cmp-label { font-size: 62px; font-weight: 800; line-height: 1.08; color: var(--cc); }
.cmp-text { font-size: 44px; font-weight: 600; line-height: 1.2; opacity: .92; }
/* VS sits on the columns' top edge, centered in the gap, clear of the column text */
.vs { position: absolute; top: -70px; left: 410px; width: 140px; height: 140px; border-radius: 50%; background: #fff;
      color: var(--stroke); display: flex; align-items: center; justify-content: center; z-index: 2;
      font-size: 50px; font-weight: 800; box-shadow: 0 12px 36px rgba(0,0,0,.4); }

/* cta: headline + action chip ("Simpan", "Komen di bawah") stacked */
.cta-stack { position: absolute; left: 60px; width: 900px; display: flex; flex-direction: column; align-items: center; gap: 30px; }
.cta-stack .headline { width: 900px; }
.cta-chip { display: inline-flex; align-items: center; gap: 18px; padding: 16px 44px 16px 32px; border-radius: 999px;
            background: var(--accent); color: var(--stroke); font-weight: 800; line-height: 1.2;
            box-shadow: 0 14px 40px {{ style.shade_color | rgba(0.4) }}; }
.cta-chip svg { width: 1.2em; height: 1.2em; stroke: var(--stroke); stroke-width: 2.6; }

{% if stage %}
{% set sc = stage.cfg %}
/* Stage scenes: props build up on a persistent background (klip.yaml stage) */
.scene.stage .stage-bg { position: absolute; inset: 0; overflow: hidden; }
.stage-pan { position: absolute; inset: -{{ sc.bg_drift_px + 20 }}px; }
.st-grain { position: absolute; inset: 0; }
{% for b in stage.bgs %}
.bg-{{ b.key }} { {{ b.css }} }
.st-grain-{{ b.key }} { {{ b.grain }} }
{% endfor %}
.st-cam, .st-props { position: absolute; inset: 0; }
.st-cam { transform-origin: 50% 42%; }
.st-el { position: absolute; }
.st-in { position: absolute; inset: 0; }
.st-dust { position: absolute; left: calc(50% - 17px); bottom: -18px; width: 34px; height: 34px; border-radius: 50%;
           background: rgba(255,255,255,.4); pointer-events: none; opacity: 0; filter: blur(2px); }
.tone-light .st-dust { background: rgba(21,21,28,.28); }
.st-cutout img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(var(--st-shadow)); }
.st-card { width: 100%; height: 100%; padding: 14px 14px 54px; background: #fff; border-radius: 6px; box-shadow: var(--st-shadow); }
.st-card img { display: block; width: 100%; height: 100%; object-fit: cover; }
.st-disc { width: 100%; height: 100%; border-radius: 50%; background: {{ sc.icon.bg }}; display: flex; align-items: center; justify-content: center; box-shadow: var(--st-shadow); }
.st-disc svg { width: 58%; height: 58%; stroke: {{ sc.icon.color }}; stroke-width: 2; }
.st-label { display: flex; align-items: center; justify-content: center; }
.st-tag { display: inline-block; padding: .16em .6em .22em; border-radius: 8px; background: var(--tag-bg); color: var(--tag-fg);
          font-weight: 800; line-height: 1.15; white-space: nowrap; box-shadow: var(--st-shadow);{% if sc.label.uppercase %} text-transform: uppercase; letter-spacing: .04em;{% endif %} }
{% for t in ("light", "dark") %}
.scene.stage.tone-{{ t }} { --st-shadow: {{ sc.shadow[t] }}; --tag-bg: {{ sc.label[t].bg }}; --tag-fg: {{ sc.label[t].color }}; --ink: {{ sc.title.ink[t] }}; }
{% endfor %}
.st-lc { position: relative; width: 100%; height: 100%; border-radius: 22px; background: {{ sc.chart.bg }}; box-shadow: var(--st-shadow); }
.st-lc svg { position: absolute; inset: 0; overflow: visible; }
.st-lc .lc-ax { font-size: .8em; font-weight: 700; fill: {{ sc.chart.muted }}; }
.st-lc .lc-bl { font-size: .72em; font-weight: 800; fill: {{ sc.chart.text }}; opacity: .75; }
.lc-title { position: absolute; left: 5%; top: 4.5%; font-size: 1.05em; font-weight: 800; color: {{ sc.chart.text }}; }
.lc-last { position: absolute; transform: translate(-100%, -150%); padding: .12em .45em; border-radius: 10px; color: #fff;
           font-size: .95em; font-weight: 800; white-space: nowrap; }
.un-box { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 12px; }
.un-grid { display: grid; }
.un-grid i { display: block; border-radius: 18%; }
.un-grid i.on { background: {{ sc.unit.fill }}; box-shadow: inset 0 -3px 0 rgba(0,0,0,.12); }
.un-grid i.off { background: {{ sc.unit.empty }}; }
.un-legend { font-weight: 800; color: var(--ink); white-space: nowrap; }
.ps-card { width: 100%; height: 100%; padding: 5%; border-radius: 16px; background: {{ sc.person.bg }}; color: {{ sc.person.text }};
             box-shadow: var(--st-shadow); display: flex; flex-direction: column; gap: .12em; }
.ps-photo { flex: 1; min-height: 0; border-radius: 10px; overflow: hidden; background: #ddd; }
.ps-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; display: block; }
.ps-name { margin-top: .25em; font-size: .78em; font-weight: 800; line-height: 1.1; }
.ps-line { font-size: .5em; font-weight: 700; color: {{ sc.person.muted }}; }
.ps-stat { font-size: .82em; font-weight: 800; line-height: 1.1; }
.nw-card { width: 100%; height: 100%; padding: .7em .9em; border-radius: 16px; background: {{ sc.news.bg }}; color: {{ sc.news.text }};
           box-shadow: var(--st-shadow); display: flex; flex-direction: column; gap: .4em; overflow: hidden; }
.nw-top { display: flex; justify-content: space-between; align-items: baseline; gap: .6em; font-size: .62em; }
.nw-top span { color: {{ sc.news.muted }}; font-weight: 600; white-space: nowrap; }
.nw-head { font-size: 1em; font-weight: 800; line-height: 1.18; }
.nf-card { width: 100%; height: 100%; padding: .8em 1em; border-radius: 1.1em; background: {{ sc.notif.bg }}; color: {{ sc.notif.text }};
           box-shadow: var(--st-shadow); display: flex; flex-direction: column; justify-content: center; gap: .18em; overflow: hidden; }
.nf-top { display: flex; align-items: center; gap: .45em; font-size: .72em; color: {{ sc.notif.muted }}; }
.nf-top b { font-weight: 700; }
.nf-top span { margin-left: auto; white-space: nowrap; }
.nf-app { width: 1.25em; height: 1.25em; border-radius: .32em; background: {{ sc.notif.app }}; flex: none; }
.nf-line { font-size: 1em; font-weight: 700; line-height: 1.2; }
.nf-stat { font-size: 2.3em; font-weight: 800; line-height: 1.05; letter-spacing: -0.02em; }
.bd-board { position: absolute; inset: 0; padding: 12px {{ sc.bg_drift_px + 20 }}px; font-weight: 700; font-variant-numeric: tabular-nums; overflow: hidden; }
.bd-row { display: flex; align-items: center; border-bottom: 1px solid rgba(255,255,255,.06); }
.bd-cell { flex: 1; padding: 0 .7em; white-space: nowrap; overflow: hidden; }
{% for b in ("board",) %}{% set bc = sc.backdrop[b] %}
.bd-cell.up { color: {{ bc.up }}; }
.bd-cell.down { color: {{ bc.down }}; }
.bd-board .bd-row:nth-child(odd) { background: {{ bc.stripe }}; }
{% endfor %}
.bd-tint, .bd-dim, .bd-shade { position: absolute; inset: 0; pointer-events: none; }
.bd-tint { mix-blend-mode: multiply; opacity: {{ sc.backdrop.tint_opacity }}; }
.bd-dim { background: #000; }
.bd-shade { background: linear-gradient(180deg, rgba(0,0,0,0) 45%, #000 100%); }
.bd-status { position: absolute; left: 70px; right: 70px; top: 44px; display: flex; justify-content: space-between; align-items: center;
             font-size: 30px; color: {{ sc.backdrop.phone.bar }}; }
.bd-status span { display: flex; gap: 8px; align-items: flex-end; }
.bd-status i { display: block; width: 7px; background: {{ sc.backdrop.phone.bar }}; border-radius: 2px; }
.bd-status i:nth-child(1) { height: 12px; } .bd-status i:nth-child(2) { height: 18px; } .bd-status i:nth-child(3) { height: 24px; }
.bd-status em { display: block; width: 44px; height: 22px; margin-left: 10px; border: 3px solid {{ sc.backdrop.phone.bar }}; border-radius: 6px; }
.bd-header { position: absolute; left: 0; right: 0; text-align: center; font-size: 30px; font-weight: 600; color: {{ sc.backdrop.phone.bar }};
             letter-spacing: .02em; }
.bd-header span { display: inline-block; padding: .2em .8em; border-radius: 999px; background: rgba(0,0,0,.85); }
.bd-phone .bd-header span { padding: 0; background: none; }
.lg-card { width: 100%; height: 100%; padding: {{ (sc.logo.pad * 100) | round(1) }}%; border-radius: 18px; background: {{ sc.logo.bg }};
           box-shadow: var(--st-shadow); display: flex; align-items: center; justify-content: center; }
.lg-card img { max-width: 100%; max-height: 100%; object-fit: contain; }
.st-shot { width: 100%; height: 100%; border-radius: 14px; overflow: hidden; background: #fff; box-shadow: var(--st-shadow); display: flex; flex-direction: column; }
.sh-bar { flex: none; height: {{ sc.screenshot.bar_px }}px; background: {{ sc.screenshot.bar }}; display: flex; align-items: center; gap: 9px; padding: 0 16px; }
.sh-bar i { width: 13px; height: 13px; border-radius: 50%; background: rgba(0,0,0,.18); }
.sh-bar span { margin-left: 12px; padding: 3px 14px; border-radius: 999px; background: #fff; font-size: 20px; font-weight: 600; color: #555;
               overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 70%; }
.st-shot img { flex: 1; min-height: 0; width: 100%; object-fit: cover; object-position: 50% 0; display: block; }
.st-stamp { display: flex; align-items: center; justify-content: center; }
.st-stamp-in { display: inline-block; padding: .1em .45em .14em; border: {{ sc.stamp.border_px }}px solid currentColor; border-radius: 18px;
               font-weight: 800; line-height: 1.1; letter-spacing: .05em; text-transform: uppercase; white-space: nowrap;
               box-shadow: inset 0 0 0 4px rgba(255,255,255,.0); opacity: .92; }
.st-subrow { position: absolute; left: -200px; right: -200px; bottom: -.75em; display: flex; justify-content: center; }
.st-num { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-weight: 800; line-height: 1;
          letter-spacing: -0.03em; white-space: nowrap; -webkit-text-stroke: .11em {{ sc.number.stroke }}; paint-order: stroke fill;
          filter: drop-shadow(0 12px 16px rgba(0,0,0,.35)); }
.st-barcard { width: 100%; height: 100%; display: flex; gap: 18px; padding: 22px 22px 14px; border-radius: 18px; background: {{ sc.bar.bg }};
            box-shadow: 0 18px 36px rgba(0,0,0,.35); }
.st-barcol { flex: 1; min-width: 0; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.st-bar { width: 100%; border-radius: 10px 10px 0 0; transform-origin: 50% 100%; }
.st-bartext { font-size: 34px; font-weight: 800; color: {{ sc.bar.text }}; margin-bottom: 6px; white-space: nowrap; }
.st-barlabel { font-size: 30px; font-weight: 700; color: {{ sc.bar.text }}; margin-top: 8px; white-space: nowrap; }
.st-coin { position: absolute; left: 50%; border-radius: 50%; background: {{ sc.icon.bg }}; display: flex; align-items: center; justify-content: center;
           border: 4px solid rgba(0,0,0,.10); box-shadow: 0 8px 14px rgba(0,0,0,.3); }
.st-coin svg { width: 60%; height: 60%; stroke: {{ sc.icon.color }}; stroke-width: 2; }
.st-hl { width: 100%; height: 100%; border: {{ sc.highlight.width }}px solid {{ sc.highlight.color }}; border-radius: 16px;
         box-shadow: 0 6px 16px rgba(0,0,0,.25); }
/* Motion components (klip.yaml stage.components) */
{% set cc = sc.components %}
.cp-card { width: 100%; height: 100%; border-radius: 22px; background: {{ cc.card }}; box-shadow: var(--st-shadow); }
.cp-in { position: relative; }
.cp-svg { position: absolute; inset: 0; overflow: visible; }
.cp-title { font-weight: 800; color: {{ cc.ink }}; margin-bottom: .5em; }
.cp-kin { width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; gap: .08em; }
.kn-line { align-self: flex-start; font-weight: 800; line-height: 1.08; letter-spacing: -0.02em; color: var(--ink); padding: 0 .08em;
           background: linear-gradient(transparent 58%, var(--accent) 58%, var(--accent) 92%, transparent 92%) no-repeat 0 0 / 0% 100%; }
.kn-w { display: inline-block; }
.sp-wrap { display: flex; flex-direction: column; height: 100%; }
.sp-bar { display: flex; gap: 6px; border-radius: 14px; overflow: visible; transform-origin: 0 50%; flex: none; }
.sp-seg { height: 100%; border-radius: 10px; background: {{ cc.track }}; transform-origin: 50% 100%; }
.sp-legend { margin-top: .8em; display: flex; flex-direction: column; gap: .35em; }
.sp-row { display: flex; align-items: center; gap: .5em; color: {{ cc.ink }}; font-weight: 700; }
.sp-row i { width: .8em; height: .8em; border-radius: 4px; flex: none; }
.sp-row span { flex: 1; min-width: 0; }
.sp-row b { font-weight: 800; }
.sp-row.acc { font-size: 1.12em; }
.cp-node { position: absolute; border-radius: 50%; background: {{ cc.ink }}; color: #fff; display: flex; align-items: center; justify-content: center;
           box-shadow: 0 8px 16px rgba(0,0,0,.18); }
.cp-node.acc, .cp-node.src { background: var(--accent); color: {{ cc.ink }}; }
.cp-node svg { width: 56%; height: 56%; stroke: currentColor; stroke-width: 2; }
.cp-lab { position: absolute; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; text-align: center;
          color: {{ cc.ink }}; font-weight: 700; line-height: 1.1; white-space: nowrap; }
.cp-lab b { font-weight: 800; }
.cp-lab.cy b { padding: .05em .3em; border-radius: 8px; background: {{ cc.card }}; }
.cp-lab.src { transform: translateY(-50%); align-items: flex-start; text-align: left; }
.cp-lab b.acc { color: {{ cc.ink }}; background: linear-gradient(transparent 55%, var(--accent) 55%); }
.mt-tube { position: absolute; border-radius: 999px; background: {{ cc.track }}; overflow: hidden; box-shadow: inset 0 4px 10px rgba(0,0,0,.08); }
.mt-fill { position: absolute; left: 0; right: 0; bottom: 0; height: 0; background: var(--accent); }
.mt-tick { position: absolute; height: 4px; margin-top: -2px; border-radius: 2px; background: {{ cc.ink }}; transform-origin: 50% 50%; }
.mt-icon { position: absolute; color: {{ cc.ink }}; }
.mt-icon svg { width: 100%; height: 100%; stroke: currentColor; stroke-width: 2; }
.mt-title { position: absolute; font-weight: 800; color: {{ cc.muted }}; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
.mt-val { position: absolute; left: 0; top: 50%; margin-top: -0.75em; display: flex; flex-direction: column; color: {{ cc.ink }}; }
.mt-val b { font-weight: 800; line-height: 1; letter-spacing: -0.03em; white-space: nowrap; }
.mt-val span { margin-top: .5em; font-weight: 700; color: {{ cc.muted }}; line-height: 1.2; }
.cy-center { position: absolute; transform: translate(-50%, -50%); text-align: center; font-weight: 800; line-height: 1.1; color: {{ cc.ink }}; }
.tl-track, .tl-line { position: absolute; width: 6px; border-radius: 3px; }
.tl-track { background: {{ cc.track }}; }
.tl-line { background: {{ cc.ink }}; }
.tl-dot { position: absolute; width: 30px; height: 30px; border-radius: 50%; background: #fff; border: 7px solid {{ cc.ink }}; box-sizing: border-box; }
.tl-dot.acc { border-color: var(--accent); }
.tl-row { position: absolute; transform: translateY(-50%); display: flex; flex-direction: column; color: {{ cc.ink }}; line-height: 1.15; }
.tl-row b { font-weight: 800; }
.tl-row b.acc { background: linear-gradient(transparent 55%, var(--accent) 55%); align-self: flex-start; }
.tl-row span { font-weight: 700; color: {{ cc.muted }}; font-size: .8em; }
.fn-layer { position: absolute; left: 0; right: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
            color: #fff; line-height: 1.05; text-align: center; }
.fn-layer b { font-weight: 800; }
.fn-layer span { font-size: .62em; font-weight: 700; opacity: .9; }
.rl-title { display: flex; align-items: center; justify-content: center; margin: 0; }
.rl-win { position: absolute; left: 0; right: 0; overflow: hidden; border-radius: 16px; background: #F4F5F7; }
.rl-item { display: flex; align-items: center; justify-content: center; font-weight: 800; color: {{ cc.ink }}; white-space: nowrap; }
.rl-shade { position: absolute; inset: 0; pointer-events: none;
            background: linear-gradient(#F4F5F7 0%, rgba(244,245,247,0) 34%, rgba(244,245,247,0) 66%, #F4F5F7 100%); }
.rl-mark { position: absolute; left: 0; right: 0; border-top: 5px solid var(--accent); border-bottom: 5px solid var(--accent); }
.st-title-row { position: absolute; left: 60px; width: 900px; top: {{ sc.title.top }}px; display: flex; justify-content: center; z-index: 50; }
.st-title { max-width: 900px; padding: 12px 30px 16px; border-radius: 8px; background: {{ sc.title.bg }}; color: {{ sc.title.color }};
            font-weight: 800; line-height: 1.1; letter-spacing: -0.01em; text-align: center; box-shadow: 0 14px 30px rgba(0,0,0,.35); }
.st-title .hw.emph { background: linear-gradient(transparent 56%, {{ sc.highlight.color }} 56%, {{ sc.highlight.color }} 92%, transparent 92%); }
.st-title-row.plain { justify-content: flex-start; }
.st-title-row.box { justify-content: flex-start; }
.st-title.box { padding: 0; border-radius: 0; background: none; box-shadow: none; text-align: left; text-transform: uppercase;
                line-height: 1.3; letter-spacing: .01em; transform-origin: 0 50%; }
.st-title.box .bx { padding: .04em .24em .08em; background: {{ sc.title.box.bg }}; color: {{ sc.title.box.color }};
                    -webkit-box-decoration-break: clone; box-decoration-break: clone; }
.st-title.box .hw.emph { padding: 0 .12em; margin: 0 -.12em; background: var(--accent); color: {{ sc.title.box.emph_color or 'var(--stroke)' }}; }
.st-title.plain { padding: 0; border-radius: 0; background: none; box-shadow: none; color: var(--ink); text-align: left; letter-spacing: -0.02em; }
.st-title.plain .hw.emph { background: linear-gradient(transparent 60%, {{ sc.title.marker or style.accent_color }} 60%, {{ sc.title.marker or style.accent_color }} 94%, transparent 94%); }
.st-no { display: inline-block; margin-right: .35em; padding: 0 .4em; border-radius: 999px; background: var(--accent); color: var(--stroke); }
{% endif %}

{% if code %}
/* Code scenes (visual.type "code"): the scene file's markup over the look's bg, the texture on top */
.scene.code { background: var(--k-bg); color: var(--k-ink); font-family: var(--k-body); }
.k-world { position: absolute; inset: 0; }
.scene.code.on-world { background: transparent; }     /* the world layer shows through */
.k-tex { position: absolute; inset: 0; pointer-events: none; z-index: 5; }
.k-tex-hud i { position: absolute; width: 70px; height: 70px; border: 0 solid rgba(255,255,255,.55); }
.k-tex-hud i:nth-child(1) { left: 40px; top: 160px; border-left-width: 3px; border-top-width: 3px; }
.k-tex-hud i:nth-child(2) { right: 40px; top: 160px; border-right-width: 3px; border-top-width: 3px; }
.k-tex-hud i:nth-child(3) { left: 40px; bottom: 140px; border-left-width: 3px; border-bottom-width: 3px; }
.k-tex-hud i:nth-child(4) { right: 40px; bottom: 140px; border-right-width: 3px; border-bottom-width: 3px; }
{% for s in scenes if s.code %}
#sc-{{ s.id }} .k-tex { {{ s.code.texture_css }} }
{% endfor %}
.k-ms-body, .k-ms-flip, .k-ms-pose { position: absolute; inset: 0; }
.k-ms-body { transform-origin: 50% 100%; }
.k-ms-flip.mirror { transform: scaleX(-1); }
.k-ms-flip.mirror .nomirror { transform: scaleX(-1); transform-box: fill-box; transform-origin: 50% 50%; }
.k-ms-pose svg { display: block; width: 100%; height: 100%; }
.k-ms .mouth-open { opacity: 0; }
.k-error { position: absolute; left: 40px; right: 40px; top: 300px; padding: 24px; z-index: 99; background: #D7263D; color: #fff;
           font: 700 34px/1.3 monospace; white-space: pre-wrap; }
{% if world %}{{ world.css }}{% endif %}
{% for s in scenes if s.code %}
{{ s.code.css }}
{% endfor %}
{% if code.caption_font %}.cap { font-family: "{{ code.caption_font }}", system-ui, sans-serif; }{% endif %}
{% endif %}

/* Scene transitions (style.transitions): overlays above the scenes, under the mascots and captions */
.tr-over { position: absolute; inset: 0; z-index: 6; pointer-events: none; opacity: 0; }
#tr-wipe { background: {{ (style.transitions or {}).get("wipe_color") or style.accent_color }}; clip-path: circle(0% at 50% 50%); opacity: 1; }
#tr-flash { background: #FFFFFF; }

/* Mascots (style.mascot): stacked pose SVGs; one shows at a time */
.ms { position: absolute; z-index: 9; opacity: 0; }
.ms-body, .ms-act, .ms-flip, .ms-pose { position: absolute; inset: 0; }
.ms-act { transform-origin: 50% 100%; }
/* spotlight behind a focus scene's star */
.ms-spot { position: absolute; left: 0; top: 0; width: 1080px; height: 1920px; z-index: 8; opacity: 0; overflow: hidden; pointer-events: none; }
.ms-spot .glow { position: absolute; width: 1000px; height: 1000px; border-radius: 50%;
                 background: radial-gradient(closest-side, {{ style.accent_color | rgba(((style.mascot or {}).get("focus") or {}).get("glow_opacity", 0)) }}, {{ style.accent_color | rgba(0) }}); }
.ms-spot .rays { position: absolute; width: 2880px; height: 2880px;
                 background: repeating-conic-gradient(from 0deg, {{ style.accent_color | rgba(((style.mascot or {}).get("focus") or {}).get("rays_opacity", 0)) }} 0deg 7deg, {{ style.accent_color | rgba(0) }} 7deg 18deg);
                 -webkit-mask-image: radial-gradient(closest-side, #000 15%, transparent 70%); mask-image: radial-gradient(closest-side, #000 15%, transparent 70%); }
{% set mo = (style.mascot or {}).get("outline") %}
.ms-body { transform-origin: 50% 100%; filter: {% if mo %}url(#ms-outline) {% endif %}drop-shadow(0 10px 10px rgba(0,0,0,.18)); }
.ms-ground { position: absolute; left: 14%; right: 14%; bottom: -10px; height: 26px; border-radius: 50%;
             background: radial-gradient(closest-side, #000, rgba(0,0,0,0)); opacity: {{ (style.mascot or {}).get("ground") or 0 }}; }
.ms-flip.mirror { transform: scaleX(-1); }
.ms-flip.mirror .nomirror { transform: scaleX(-1); transform-box: fill-box; transform-origin: 50% 50%; }
.ms-pose { opacity: 0; }
.ms-pose svg { display: block; }

/* Captions */
.cap { position: absolute; left: 60px; width: 900px; top: {{ style.caption.top }}px; height: {{ style.caption.height }}px;
       display: flex; flex-wrap: wrap; align-content: center; justify-content: center; gap: 0 22px;
       font-size: {{ style.caption.font_size }}px; font-weight: {{ style.caption.font_weight }};
       line-height: 1.12; text-align: center; z-index: 10;
       -webkit-text-stroke: {{ style.caption.stroke_px }}px var(--stroke); paint-order: stroke fill; }
{% if cap.base.shadow %}.cap { text-shadow: {{ cap.base.shadow }}; }{% endif %}
.cap .w { display: inline-block; }
.cap .w.emph { color: var(--emph); }
.cap .w.on { color: var(--accent); }
.cap .w.ul { background-image: linear-gradient(var(--accent), var(--accent)); background-repeat: no-repeat;
             background-position: 0 100%; background-size: 0% .13em; padding-bottom: .06em; }
{% set cs = cap.stage %}
.cap.st { top: {{ cs.top }}px; height: {{ cs.height }}px; font-size: {{ cs.font_size }}px; gap: 0 {{ (cs.font_size * 0.27) | round(1) }}px;
          -webkit-text-stroke: {{ cs.stroke_px }}px var(--stroke);{% if cs.shadow %} text-shadow: {{ cs.shadow }};{% endif %} }
{% if cs.on_light %}.cap.st.light { color: {{ cs.on_light.color }}; text-shadow: {{ cs.on_light.shadow }}; }{% endif %}

/* Branding strip (top of the safe zone): progress bar, watermark, series pill */
{% set b = brand %}
{% if b.progress %}
.progress { position: absolute; left: {{ b.progress.left }}px; top: {{ b.progress.top }}px; width: {{ b.progress.width }}px;
            height: {{ b.progress.height }}px; border-radius: 999px; background: {{ b.progress.track }}; overflow: hidden; z-index: 11; }
.progress .fill { position: absolute; inset: 0; background: {{ b.progress.color }}; border-radius: 999px;
                  transform-origin: 0 50%; transform: scaleX(0); }
.progress .tick { position: absolute; top: 0; width: 4px; height: 100%; margin-left: -2px; background: var(--stroke); opacity: .55; }
{% endif %}
{% if b.watermark %}
.wm { position: absolute; top: {{ b.watermark.top }}px; right: {{ b.watermark.right }}px; height: {{ b.watermark.size }}px;
      display: flex; align-items: center; gap: 14px; opacity: {{ b.watermark.opacity }}; z-index: 11; }
.wm img { width: {{ b.watermark.size }}px; height: {{ b.watermark.size }}px; }
.wm span { font-size: 30px; font-weight: 700; -webkit-text-stroke: 6px var(--stroke); paint-order: stroke fill; }
{% endif %}
{% if b.series %}
.pill { position: absolute; left: {{ b.series.left }}px; top: {{ b.series.top }}px; padding: 10px 22px; border-radius: 999px;
        background: {{ b.series.bg }}; color: {{ b.series.color }}; font-size: {{ b.series.font_size }}px;
        font-weight: {{ b.series.font_weight }}; letter-spacing: .04em; line-height: 1.2; z-index: 11;
        transform-origin: 0 50%; box-shadow: 0 8px 24px {{ style.shade_color | rgba(0.35) }}; }
{% endif %}
{% if b.save_nudge %}
.nudge { position: absolute; left: 60px; width: 900px; top: {{ b.save_nudge.top }}px; display: flex; justify-content: center; z-index: 11; }
.nudge-in { display: inline-flex; align-items: center; gap: 14px; padding: 10px 30px 10px 22px; border-radius: 999px;
            background: {{ b.save_nudge.bg }}; border: 3px solid var(--accent); font-size: {{ b.save_nudge.font_size }}px;
            font-weight: 800; line-height: 1.2; box-shadow: 0 10px 30px {{ style.shade_color | rgba(0.35) }}; }
.nudge-in svg { width: 1.15em; height: 1.15em; stroke: var(--accent); stroke-width: 2.6; }
{% endif %}
{% if b.outro %}
.outro { position: absolute; left: 60px; width: 900px; top: {{ b.outro.top }}px; display: flex; justify-content: center; z-index: 12; }
.outro-in { display: flex; align-items: center; gap: 26px; padding: 22px 34px 22px 22px; border-radius: 34px;
            background: {{ b.outro.bg }}; box-shadow: 0 18px 50px rgba(0,0,0,.35); max-width: 900px; }
.outro-logo { flex: none; width: 140px; height: 140px; border-radius: 50%; display: flex; align-items: center; justify-content: center;{% if b.outro.disc %} background: {{ b.outro.disc }};{% endif %} }
.outro-logo img { width: 84%; }
.outro-col { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
.outro-text { font-size: {{ b.outro.font_size }}px; font-weight: 800; line-height: 1.12; letter-spacing: -0.01em; }
.outro-text .hw.emph { color: var(--accent); }
{% endif %}
{% if b.end_card %}
.ec-disc { position: absolute; left: 310px; top: 260px; width: 460px; height: 460px; border-radius: 50%;
           display: flex; align-items: center; justify-content: center; }
.ec-logo { width: 380px; }
.ec-word { position: absolute; left: 50%; top: 760px; width: 700px; margin-left: -350px; }
.ec-tag { position: absolute; left: 60px; width: 900px; top: 1070px; text-align: center; font-size: 46px; font-weight: 700; color: var(--accent); }
{% endif %}
</style>
</head>
<body>
<div id="root" data-composition-id="main" data-start="0" data-duration="{{ total }}" data-width="1080" data-height="1920">
{% for s in scenes if not s.hidden %}{% for m in s.shots %}
  {% if m.kind == "video" %}
  <video id="{{ m.id }}" class="media clip" src="{{ m.src }}" muted playsinline data-start="{{ m.start }}" data-duration="{{ m.dur }}" data-track-index="2"></video>
  {% else %}
  <img id="{{ m.id }}" class="media clip" src="{{ m.src }}" alt="" data-start="{{ m.start }}" data-duration="{{ m.dur }}" data-track-index="2" />
  {% endif %}
{% endfor %}{% endfor %}
{% if world %}
  <section id="sc-world" class="scene clip code world" data-start="{{ world.meta.start }}" data-duration="{{ world.meta.dur }}" data-track-index="1">
    <div class="k-world">{{ world.markup }}</div>
  </section>
{% endif %}
{% for s in scenes if not s.hidden %}
  <section id="sc-{{ s.id }}" class="scene clip{{ ' has-media' if s.media }}{{ (' stage tone-' ~ s.stage.tone) if s.stage }}{{ ' code' if s.code }}{{ ' on-world' if s.get('on_world') }}" data-start="{{ s.start }}" data-duration="{{ s.dur }}" data-track-index="0"
           style="--c1: {{ s.c1 }}; --c2: {{ s.c2 }};">
    {% if s.stage %}
    {% include "scenes/stage.html.j2" %}
    {% elif s.code %}
    <div class="k-world">{{ s.code.markup }}</div>
    <div class="k-tex k-tex-{{ s.code.texture }}">{% if s.code.texture == "hud" %}<i></i><i></i><i></i><i></i>{% endif %}</div>
    {% else %}
    <div class="bg"></div><div class="blob b1"></div><div class="blob b2"></div><div class="grain"></div>
    <div class="content">
    {% include "scenes/" ~ s.template ~ ".html.j2" %}
    </div>
    {% endif %}
  </section>
{% endfor %}
{% if brand.progress %}
  <div id="progress" class="progress clip" data-start="0" data-duration="{{ total }}" data-track-index="5">
    <div class="fill"></div>{% for x in brand.progress.ticks %}<div class="tick" style="left: {{ x }}px;"></div>{% endfor %}
  </div>
{% endif %}
{% if brand.watermark %}{% for sp in brand.watermark.spans %}
  <div id="wm-{{ sp.k }}" class="wm clip" data-start="{{ sp.start }}" data-duration="{{ sp.dur }}" data-track-index="3">
    {% if brand.watermark.text %}<span>{{ brand.watermark.text }}</span>{% endif %}{% if brand.watermark.img %}<img src="{{ brand.watermark.img.src }}" alt="" />{% endif %}
  </div>
{% endfor %}{% endif %}
{% if brand.series %}{% for sp in brand.series.spans %}
  <div id="pill-{{ sp.k }}" class="pill clip" data-start="{{ sp.start }}" data-duration="{{ sp.dur }}" data-track-index="4">{{ brand.series.label }}</div>
{% endfor %}{% endif %}
{% if brand.save_nudge %}
  <div id="nudge" class="nudge clip" data-start="{{ brand.save_nudge.start }}" data-duration="{{ brand.save_nudge.dur }}" data-track-index="6">
    <div class="nudge-in">{{ brand.save_nudge.icon | safe }}<span>{{ brand.save_nudge.text }}</span></div>
  </div>
{% endif %}
{% if brand.outro %}{% set o = brand.outro %}
  <div id="outro" class="outro clip" data-start="{{ o.start }}" data-duration="{{ o.dur }}" data-track-index="7">
    <div class="outro-in">
      {% if o.logo %}<div class="outro-logo"><img src="{{ o.logo.src }}" alt="" /></div>{% endif %}
      <div class="outro-col">
        {% if o.text %}<div class="outro-text">{% for h in o.text %}<span class="hw{{ ' emph' if h.emph }}">{{ h.text }}</span>{{ ' ' if not loop.last }}{% endfor %}</div>{% endif %}
        {% if o.chip %}<div class="cta-chip" style="font-size: 38px;">{{ o.chip.icon | safe }}<span>{{ o.chip.label }}</span></div>{% endif %}
      </div>
    </div>
  </div>
{% endif %}
{% set trs = scenes | selectattr("tr_in") | list %}
{% if trs %}
<svg width="0" height="0" style="position: absolute;" aria-hidden="true"><filter id="tr-whip" x="-20%" y="0" width="140%" height="100%">
  <feGaussianBlur id="tr-whip-b" in="SourceGraphic" stdDeviation="0 0" /></filter></svg>
<div id="tr-wipe" class="tr-over"></div>
<div id="tr-flash" class="tr-over"></div>
{% endif %}
{% if mascots and (style.mascot or {}).get("outline") %}{% set mo = style.mascot.outline %}
<svg width="0" height="0" style="position: absolute;" aria-hidden="true"><filter id="ms-outline" x="-10%" y="-10%" width="120%" height="120%">
  <feMorphology in="SourceAlpha" operator="dilate" radius="{{ mo.px }}" result="d" /><feFlood flood-color="{{ mo.color }}" />
  <feComposite in2="d" operator="in" result="o" /><feMerge><feMergeNode in="o" /><feMergeNode in="SourceGraphic" /></feMerge>
</filter></svg>
{% endif %}
{% for m in mascots or [] if m.focus %}
  {% set f0 = m.focus[0] %}
  <div id="{{ m.id }}-spot" class="ms-spot"><div class="rays" style="left: {{ f0.cx - 1440 }}px; top: {{ f0.cy - 1440 }}px;"></div><div class="glow" style="left: {{ f0.cx - 500 }}px; top: {{ f0.cy - 500 }}px;"></div></div>
{% endfor %}
{% for m in mascots or [] %}
  <div id="{{ m.id }}" class="ms clip" data-start="0" data-duration="{{ total }}" data-track-index="8"
       style="left: {{ m.x }}px; top: {{ m.y }}px; width: {{ m.w }}px; height: {{ m.h }}px; transform-origin: {{ m.origin }};">
    {% if (style.mascot or {}).get("ground") %}<div class="ms-ground"></div>{% endif %}
    <div class="ms-body"><div class="ms-act"><div class="ms-flip{{ ' mirror' if m.mirror }}">
      {% for p in m.poses %}<div class="ms-pose" data-p="{{ p.name }}">{{ p.svg | safe }}</div>{% endfor %}
    </div></div></div>
  </div>
{% endfor %}
{% for p in pages %}
  <div id="{{ p.id }}" class="cap clip{{ ' st' if p.stage }}{{ ' light' if p.light }}" data-start="{{ p.start }}" data-duration="{{ p.dur }}" data-track-index="1">
    {% for w in p.words %}<span id="{{ w.id }}" class="{{ w.cls }}{{ ' ul' if p.highlight == 'underline' }}">{{ w.text }}</span>{% endfor %}
  </div>
{% endfor %}
</div>
<script>
const tl = gsap.timeline({ paused: true });
{% if stage %}
// count a number up in an element's text (motion components): c = {prefix, value, decimals, suffix}
const klipFmt = (v, c) => {
  const [whole, frac] = Math.abs(v).toFixed(c.decimals).split(".");
  return c.prefix + (v < 0 ? "-" : "") + whole.replace(/\B(?=(\d{3})+(?!\d))/g, ".") + (frac ? "," + frac : "") + c.suffix;
};
function klipCount(sel, from, c, at, dur) {
  const el = document.querySelector(sel);
  const n = { v: from };
  tl.fromTo(n, { v: from }, { v: c.value, duration: dur, ease: "power2.out", onUpdate: () => { el.textContent = klipFmt(n.v, c); } }, at);
}
{% endif %}
{% if code %}
{% include "scenes/code_kit.js.j2" %}
{% endif %}
{% if world %}
// ---- world (one layer under scenes {{ world.meta.scenes | map(attribute="id") | join(", ") }})
klipScene({{ world.meta | tojson }}, function (k) {
{{ world.js }}
});
{% endif %}
{% for s in scenes if not s.hidden %}
// ---- scene {{ s.id }} ({{ s.template }}{{ ', stage' if s.stage }}{{ ', code' if s.code }})
{% if s.stage %}
{% include "scenes/stage.js.j2" %}
{% elif s.code %}
klipScene({{ s.code.meta | tojson }}, function (k) {
{{ s.code.js }}
});
{% else %}
{% if style.transition == "punch" %}
tl.fromTo("#sc-{{ s.id }} .bg", { scale: 1.12 }, { scale: 1, duration: 0.35, ease: "power2.out" }, {{ s.start }});
{% endif %}
{% set punch = style.transition == "punch" %}
{% for m in s.shots %}
{# first shot: scene entrance (stronger on the hook); later shots: a quick punch-in on the cut #}
{% set from_scale = ((1.25 if s.idx == 0 else 1.15) if m.k == 0 else cut_zoom) if punch else 1.0 %}
{% set settle = 0.4 if m.k == 0 else 0.25 %}
tl.fromTo("#{{ m.id }}", { scale: {{ from_scale }}, opacity: {{ 1 if punch or s.idx == 0 or m.k > 0 else 0 }} }, { scale: 1, opacity: 1, duration: {{ settle }}, ease: "power2.out" }, {{ m.start }});
tl.to("#{{ m.id }}", { scale: {{ 1.10 if m.kind == "photo" else 1.05 }}, x: {{ -30 if (s.idx + m.k) % 2 else 30 }}, duration: {{ [m.dur - settle, 0.1] | max | round(3) }}, ease: "none" }, {{ (m.start + settle) | round(3) }});
{% endfor %}
// ambient drift: blurred blobs alone change too little per frame and read as a freeze
tl.fromTo("#sc-{{ s.id }} .content", { y: 0 }, { y: -24, duration: {{ s.dur }}, ease: "sine.inOut", immediateRender: false }, {{ s.start }});
tl.fromTo("#sc-{{ s.id }} .b1", { x: 0, y: 0 }, { x: 180, y: 140, duration: {{ s.dur }}, ease: "none" }, {{ s.start }});
tl.fromTo("#sc-{{ s.id }} .b2", { x: 0, y: 0 }, { x: -160, y: -120, duration: {{ s.dur }}, ease: "none" }, {{ s.start }});
{% include "scenes/" ~ s.template ~ ".js.j2" %}
{% endif %}
{% endfor %}
{% if trs %}
// ---- scene transitions (klip/transitions.py): the outgoing half, then the incoming half
{% set T = style.transitions %}
{% for s in scenes if not s.hidden %}
{% for r, way in [(s.tr_out, "out"), (s.tr_in, "in")] if r %}
{% set at = r.at %}{% set d = r.d %}{% set sel = r.sel %}
{% if r.kind == "whip" %}
tl.set("{{ sel }}", { filter: "url(#tr-whip)" }, {{ at }});
{% if way == "out" %}
tl.fromTo("{{ sel }}", { x: 0, scale: 1 }, { x: {{ -r.dir * T.whip_px }}, scale: {{ T.whip_scale }}, duration: {{ d }}, ease: "power3.in", immediateRender: false }, {{ at }});
tl.fromTo("#tr-whip-b", { attr: { stdDeviation: "0 0" } }, { attr: { stdDeviation: "{{ T.whip_blur }} 0" }, duration: {{ d }}, ease: "power2.in", immediateRender: false }, {{ at }});
{% else %}
tl.fromTo("{{ sel }}", { x: {{ r.dir * T.whip_px }}, scale: {{ T.whip_scale }} }, { x: 0, scale: 1, duration: {{ d }}, ease: "power3.out", immediateRender: false }, {{ at }});
tl.fromTo("#tr-whip-b", { attr: { stdDeviation: "{{ T.whip_blur }} 0" } }, { attr: { stdDeviation: "0 0" }, duration: {{ d }}, ease: "power2.out", immediateRender: false }, {{ at }});
tl.set("{{ sel }}", { filter: "none" }, {{ (at + d) | round(3) }});
{% endif %}
{% elif r.kind == "zoom" %}
{% if way == "out" %}
tl.fromTo("{{ sel }}", { scale: 1, filter: "blur(0px)" }, { scale: {{ T.zoom_out }}, filter: "blur({{ T.zoom_blur }}px)", transformOrigin: "540px 860px", duration: {{ d }}, ease: "power3.in", immediateRender: false }, {{ at }});
tl.fromTo("#tr-flash", { opacity: 0 }, { opacity: 0.35, duration: {{ d }}, ease: "power2.in", immediateRender: false }, {{ at }});
{% else %}
tl.fromTo("{{ sel }}", { scale: {{ T.zoom_in }}, filter: "blur({{ T.zoom_blur }}px)" }, { scale: 1, filter: "blur(0px)", transformOrigin: "540px 860px", duration: {{ d }}, ease: "power3.out", immediateRender: false }, {{ at }});
tl.fromTo("#tr-flash", { opacity: 0.35 }, { opacity: 0, duration: {{ d }}, ease: "power2.out", immediateRender: false }, {{ at }});
tl.set("{{ sel }}", { filter: "none" }, {{ (at + d) | round(3) }});
{% endif %}
{% elif r.kind == "wipe" %}
{% set x0 = 15 if r.dir > 0 else 85 %}{% set x1 = 100 - x0 %}
{% if way == "out" %}
tl.fromTo("#tr-wipe", { clipPath: "circle(0% at {{ x0 }}% 45%)" }, { clipPath: "circle(130% at {{ x0 }}% 45%)", duration: {{ d }}, ease: "power3.in", immediateRender: false }, {{ at }});
{% else %}
tl.fromTo("#tr-wipe", { clipPath: "circle(130% at {{ x1 }}% 45%)" }, { clipPath: "circle(0% at {{ x1 }}% 45%)", duration: {{ d }}, ease: "power3.out", immediateRender: false }, {{ at }});
tl.fromTo("{{ sel }}", { scale: 1.08 }, { scale: 1, duration: {{ (d + 0.2) | round(3) }}, ease: "power2.out", immediateRender: false }, {{ at }});
{% endif %}
{% elif r.kind == "flash" %}
{% if way == "out" %}
tl.fromTo("#tr-flash", { opacity: 0 }, { opacity: {{ T.flash_opacity }}, duration: {{ d }}, ease: "power3.in", immediateRender: false }, {{ at }});
{% else %}
tl.fromTo("#tr-flash", { opacity: {{ T.flash_opacity }} }, { opacity: 0, duration: {{ d }}, ease: "power2.out", immediateRender: false }, {{ at }});
tl.fromTo("{{ sel }}", { x: -18 }, { x: 0, duration: {{ d }}, ease: "elastic.out(1, 0.3)", immediateRender: false }, {{ at }});
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
// ---- branding: progress fills linearly over the whole video; the pill punches in with its scene
{% if brand.progress %}
tl.fromTo("#progress .fill", { scaleX: 0 }, { scaleX: 1, duration: {{ total }}, ease: "none" }, 0);
{% endif %}
{% if brand.series %}{% for sp in brand.series.spans %}
tl.fromTo("#pill-{{ sp.k }}", { scale: 1.2 }, { scale: 1, duration: 0.3, ease: "back.out(2.2)" }, {{ sp.start }});
{% endfor %}{% endif %}
{% if brand.save_nudge %}
{% set n = brand.save_nudge %}
tl.fromTo("#nudge .nudge-in", { scale: 0.6, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: "back.out(2.4)" }, {{ n.start }});
tl.fromTo("#nudge svg", { rotation: 0 }, { rotation: -14, duration: 0.15, yoyo: true, repeat: 3, ease: "sine.inOut", immediateRender: false }, {{ (n.start + 0.35) | round(3) }});
tl.to("#nudge .nudge-in", { opacity: 0, y: -12, duration: 0.25, ease: "power1.in" }, {{ (n.start + n.dur - 0.25) | round(3) }});
{% endif %}
{% if brand.outro %}
{% set o = brand.outro %}
{% if o.lift %}tl.to("#sc-{{ o.lift }} .st-props", { y: -{{ o.lift_px }}, scale: {{ o.shrink }}, duration: 0.45, ease: "power2.inOut" }, {{ o.start }});
// the camera keeps drifting in under the closing badge, so the last seconds aren't a still
{% if stage %}tl.fromTo("#sc-{{ o.lift }} .st-cam", { scale: {{ stage.cfg.zoom }} }, { scale: {{ stage.cfg.zoom + stage.cfg.outro_drift }}, duration: {{ (total - o.start) | round(3) }}, ease: "none", immediateRender: false }, {{ o.start }});{% endif %}{% endif %}
tl.fromTo("#outro .outro-in", { y: 140, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: "back.out(1.6)" }, {{ o.start }});
{% if o.logo %}tl.fromTo("#outro .outro-logo", { scale: 0, rotation: -40 }, { scale: 1, rotation: 0, duration: 0.45, ease: "back.out(2.2)" }, {{ (o.start + 0.1) | round(3) }});{% endif %}
{% if o.chip %}
tl.fromTo("#outro .cta-chip", { scale: 0 }, { scale: 1, duration: 0.4, ease: "back.out(2.5)" }, {{ o.chip_at }});
{% for k in range(((o.start + o.dur - o.chip_at - 0.6) / 0.8) | int) %}tl.fromTo("#outro .cta-chip", { scale: 1 }, { scale: 1.07, duration: 0.4, yoyo: true, repeat: 1, ease: "sine.inOut", immediateRender: false }, {{ (o.chip_at + 0.6 + k * 0.8) | round(3) }});
{% endfor %}{% endif %}
{% endif %}
// ---- captions: pop-in per page, active-word highlight
{% for p in pages %}
{% if p.start > 0 %}
tl.fromTo("#{{ p.id }}", { scale: 0.86, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.12, ease: "back.out(2)" }, {{ p.start }});
{% else %}
tl.fromTo("#{{ p.id }}", { scale: 1.12 }, { scale: 1, duration: 0.2, ease: "back.out(2)" }, 0);
{% endif %}
{% for w in p.words %}
{% if p.highlight == "underline" %}
tl.fromTo("#{{ w.id }}", { backgroundSize: "0% 0.13em" }, { backgroundSize: "100% 0.13em", duration: 0.14, ease: "power2.out", immediateRender: false }, {{ w.on }});
tl.set("#{{ w.id }}", { backgroundSize: "0% 0.13em" }, {{ w.off }});
{% else %}
tl.set("#{{ w.id }}", { className: "{{ w.cls }} on" }, {{ w.on }});
tl.set("#{{ w.id }}", { className: "{{ w.cls }}" }, {{ w.off }});
{% endif %}
{% endfor %}
{% endfor %}
{% if mascots %}
{% set mc = style.mascot %}
// ---- mascots: enter/leave with the stage scenes, poses, flip-book lip sync, blinks, idle bob
{% for m in mascots %}
{% set ms = "#" ~ m.id %}
gsap.set("{{ ms }} .ms-pose[data-p='netral']", { opacity: 1 });
gsap.set("{{ ms }}", { scale: {{ m.scale0 }}, x: {{ m.dx0 }}, transformOrigin: "{{ m.origin }}" });
{% for z in m.scales %}
{% if z.snap %}tl.set("{{ ms }}", { scale: {{ z.s }}, x: {{ z.dx }} }, {{ z.t }});
{% else %}tl.to("{{ ms }}", { scale: {{ z.s }}, x: {{ z.dx }}, duration: {{ (mc.focus or {}).get("move_s", 0.45) }}, ease: "back.inOut(1.2)" }, {{ z.t }});{% endif %}
{% endfor %}
{% for sp in m.spans %}
tl.fromTo("{{ ms }}", { opacity: 0, y: 70 }, { opacity: 1, y: 0, duration: {{ mc.enter_s }}, ease: "back.out(1.6)", immediateRender: false }, {{ sp.start }});
{% if mc.lively and mc.lively.enter_squash < 1 %}
tl.fromTo("{{ ms }} .ms-act", { scaleY: {{ mc.lively.enter_squash }}, scaleX: {{ 2 - mc.lively.enter_squash }} }, { scaleY: 1, scaleX: 1, duration: 0.5, ease: "elastic.out(1, 0.45)", immediateRender: false }, {{ (sp.start + mc.enter_s * 0.6) | round(3) }});
{% endif %}
{% if sp.end < total - 0.05 %}tl.to("{{ ms }}", { opacity: 0, y: 70, duration: 0.25, ease: "power2.in" }, {{ (sp.end - 0.25) | round(3) }});{% endif %}
{% endfor %}
{% for f in m.focus %}
tl.fromTo("{{ ms }}-spot", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "power2.out", immediateRender: false }, {{ f.start }});
tl.fromTo("{{ ms }}-spot .rays", { rotation: 0 }, { rotation: {{ mc.focus.rays_turn_deg }}, duration: {{ (f.end - f.start) | round(3) }}, ease: "none", immediateRender: false }, {{ f.start }});
tl.set("{{ ms }}-spot .rays", { left: {{ f.cx - 1440 }}, top: {{ f.cy - 1440 }} }, {{ f.start }}); tl.set("{{ ms }}-spot .glow", { left: {{ f.cx - 500 }}, top: {{ f.cy - 500 }} }, {{ f.start }});
tl.to("{{ ms }}-spot", { opacity: 0, duration: 0.3, ease: "power2.in" }, {{ (f.end - 0.3) | round(3) }});
{% endfor %}
{% if mc.lively %}{% set lv = mc.lively %}
{% for g in m.gestures %}
{% if g.k == "nod" %}
tl.fromTo("{{ ms }} .ms-act", { scaleY: 1, scaleX: 1 }, { scaleY: {{ 1 - lv.nod * g.a }}, scaleX: {{ 1 + lv.nod * 0.6 * g.a }}, duration: 0.12, yoyo: true, repeat: 1, ease: "power1.inOut", immediateRender: false }, {{ g.t }});
{% elif g.k == "hop" %}
tl.fromTo("{{ ms }} .ms-act", { y: 0 }, { y: -{{ lv.hop_px * g.a }}, duration: 0.16, yoyo: true, repeat: 1, ease: "power2.out", immediateRender: false }, {{ g.t }});
tl.fromTo("{{ ms }} .ms-act", { scaleY: 1, scaleX: 1 }, { scaleY: {{ 1 - lv.nod * 1.5 }}, scaleX: {{ 1 + lv.nod }}, duration: 0.09, yoyo: true, repeat: 1, ease: "power1.inOut", immediateRender: false }, {{ (g.t + 0.32) | round(3) }});
{% else %}
tl.fromTo("{{ ms }} .ms-act", { rotation: 0 }, { rotation: {{ (-lv.lean_deg if g.k == "lean_l" else lv.lean_deg) * g.a }}, duration: 0.3, yoyo: true, repeat: 1, ease: "sine.inOut", immediateRender: false }, {{ g.t }});
{% endif %}
{% endfor %}
{% endif %}
{% for sg in m.segments[1:] %}
tl.set("{{ ms }} .ms-pose", { opacity: 0 }, {{ sg.t }});
tl.set("{{ ms }} .ms-pose[data-p='{{ sg.pose }}']", { opacity: 1 }, {{ sg.t }});
tl.fromTo("{{ ms }} .ms-body", { scale: 0.92 }, { scale: 1, duration: 0.22, ease: "back.out(3)", immediateRender: false }, {{ sg.t }});
{% endfor %}
{% for a, b in m.mouth %}
tl.set("{{ ms }} .mouth", { opacity: 0 }, {{ a }}); tl.set("{{ ms }} .mouth-open", { opacity: 1 }, {{ a }});
tl.set("{{ ms }} .mouth", { opacity: 1 }, {{ b }}); tl.set("{{ ms }} .mouth-open", { opacity: 0 }, {{ b }});
{% endfor %}
{% for t in m.blinks %}
// GSAP sets an SVG element's origin itself (from its bbox); a CSS transform-box on it shifts the eyes
tl.fromTo("{{ ms }} .eye", { scaleY: 1 }, { scaleY: 0.1, transformOrigin: "50% 50%", duration: 0.07, yoyo: true, repeat: 1, ease: "none", immediateRender: false }, {{ t }});
{% endfor %}
{% if brand.outro and brand.outro.lift is not none %}
tl.to("{{ ms }}", { y: -{{ mc.outro_lift_px }}, duration: 0.45, ease: "power2.inOut" }, {{ brand.outro.start }});
{% endif %}
{% set halves = (total / mc.bob_s) | int %}
{% if halves >= 2 %}
tl.fromTo("{{ ms }} .ms-body", { y: 0 }, { y: -{{ mc.bob_px }}, duration: {{ mc.bob_s }}, yoyo: true, repeat: {{ (halves // 2) * 2 - 1 }}, ease: "sine.inOut" }, {{ m.bob_delay }});
tl.fromTo("{{ ms }} .wag", { rotation: 0 }, { rotation: -8, transformOrigin: "0% 100%", duration: {{ mc.bob_s * 0.6 }}, yoyo: true, repeat: {{ (halves // 2) * 2 - 1 }}, ease: "sine.inOut" }, {{ m.bob_delay }});
{% endif %}
{% endfor %}
{% endif %}
window.__timelines = window.__timelines || {};
window.__timelines["main"] = tl;
</script>
</body>
</html>
