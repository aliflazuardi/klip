    {# Headline and columns share one flex column, so a two-line headline pushes the
       columns (and the VS badge on their top edge) down instead of running under them. #}
    <div class="cmp-stack" style="top: {{ 250 if s.headline else 260 }}px;">
      {% if s.headline %}<div class="headline" style="font-size: 80px;">{% include "scenes/_headline.html.j2" %}</div>{% endif %}
      <div class="cmp">
        {% for side, key in [(s.t.left, "left"), (s.t.right, "right")] %}
        <div class="cmp-col {{ key }}">
          {% if side.icon %}<div class="cmp-ic">{{ side.icon | safe }}</div>{% endif %}
          <div class="cmp-label">{{ side.label }}</div>
          {% if side.text %}<div class="cmp-text">{{ side.text }}</div>{% endif %}
        </div>
        {% endfor %}
        <div class="vs">VS</div>
      </div>
    </div>
