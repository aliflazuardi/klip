// Frame 0 matters: the headline is fully visible from the first frame and punches in by scale.
// Scale the whole block (not each word) so words never overlap while they settle.
tl.fromTo("#sc-{{ s.id }} .headline", { scale: {{ style.headline.hook_punch }} }, { scale: 1, duration: 0.3, ease: "back.out(2.2)" }, {{ s.start }});
tl.to("#sc-{{ s.id }} .headline", { scale: 1.06, duration: {{ [s.dur - 0.3, 0.1] | max | round(3) }}, ease: "none" }, {{ (s.start + 0.3) | round(3) }});
{% if s.icon %}tl.fromTo("#sc-{{ s.id }} .iconwrap", { scale: 1.3, rotation: -12 }, { scale: 1, rotation: 0, duration: 0.35, ease: "back.out(2)" }, {{ s.start }});{% endif %}
