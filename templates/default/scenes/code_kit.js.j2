// ---- scene kit `k` for code scenes (contract: docs/CODE-SCENES.md)
const KLIP_LOOK = {{ code_look | tojson }};
const KLIP_KIT = {{ code.kit | tojson }};
const KLIP_CAST = {{ (code.cast or none) | tojson }};
let klipMascotN = 0, klipGlowN = 0;
const klipNorm = (s) => String(s).toLowerCase().replace(/[^\p{L}\p{N}_]/gu, "");
function klipScene(meta, body) {
  const root = document.getElementById("sc-" + meta.id);
  const sub = gsap.timeline();
  sub.set({}, {}, meta.dur);                       // the scene timeline spans the whole scene
  tl.add(sub, meta.start);
  const words = meta.words.map((w) => ({ ...w, n: klipNorm(w.text) }));
  const k = {
    id: meta.id, root, tl: sub, dur: meta.dur, W: 1080, H: 1920, words: meta.words, text: meta.text,
    emphasis: meta.emphasis, look: KLIP_LOOK, safe: meta.safe, lib: { THREE: window.THREE },
    // the music's beats in this scene: [{t (scene s), n (beat number in the video), down (bar start), s (0-1 strength)}]
    beats: meta.beats || [], bpm: meta.bpm ?? null, period: meta.period ?? null, fps: meta.fps || 30,
    // the world layer only: the scenes it runs under, [{id, start, end}] in its own seconds
    scenes: meta.scenes || [],
