    sceneAt(t) {
      const sc = meta.scenes || [];
      for (let i = 0; i < sc.length; i++) if (t < sc[i].end || i === sc.length - 1) return { ...sc[i], i, p: Math.max(0, Math.min(1, (t - sc[i].start) / (sc[i].end - sc[i].start))) };
      return null;
    },
    $: (sel) => root.querySelector(sel),
    $$: (sel) => Array.from(root.querySelectorAll(sel)),
    // when the voice says `phrase` (scene seconds), at or after `after`
    at(phrase, after = 0) {
      const t = k.find(phrase, after);
      if (t !== null) return t;
      console.warn(`klip ${meta.id}: k.at(${JSON.stringify(phrase)}) not in the narration`);
      return Math.min(after, meta.dur);
    },
    // like k.at, but null when the phrase isn't said (reusable scenes: time on a word if it's there)
    find(phrase, after = 0) {
      const want = String(phrase).split(/\s+/).map(klipNorm).filter(Boolean);
      for (let i = 0; i + want.length <= words.length; i++) {
        if (words[i].t + 1e-3 < after) continue;
        if (want.every((w, j) => words[i + j].n === w)) return words[i].t;
