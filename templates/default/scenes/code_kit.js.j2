// ---- scene kit `k` for code scenes (contract: docs/CODE-SCENES.md)
const KLIP_LOOK = {{ code_look | tojson }};
const KLIP_CAST = {{ (code.cast or none) | tojson }};
let klipMascotN = 0;
const klipNorm = (s) => String(s).toLowerCase().replace(/[^\p{L}\p{N}_]/gu, "");
function klipScene(meta, body) {
  const root = document.getElementById("sc-" + meta.id);
  const sub = gsap.timeline();
  sub.set({}, {}, meta.dur);                       // the scene timeline spans the whole scene
  tl.add(sub, meta.start);
  const words = meta.words.map((w) => ({ ...w, n: klipNorm(w.text) }));
  const k = {
    id: meta.id, root, tl: sub, dur: meta.dur, W: 1080, H: 1920, words: meta.words, text: meta.text,
    emphasis: meta.emphasis, look: KLIP_LOOK, safe: meta.safe, lib: { THREE: window.THREE },
    $: (sel) => root.querySelector(sel),
    $$: (sel) => Array.from(root.querySelectorAll(sel)),
    // when the voice says `phrase` (scene seconds), at or after `after`
    at(phrase, after = 0) {
      const want = String(phrase).split(/\s+/).map(klipNorm).filter(Boolean);
      for (let i = 0; i + want.length <= words.length; i++) {
        if (words[i].t + 1e-3 < after) continue;
        if (want.every((w, j) => words[i + j].n === w)) return words[i].t;
      }
      console.warn(`klip ${meta.id}: k.at(${JSON.stringify(phrase)}) not in the narration`);
      return Math.min(after, meta.dur);
    },
    // fn(t) on every frame of the scene (canvas, Three.js): a pure function of scene time t
    frame(fn) {
      const p = { t: 0 };
      sub.fromTo(p, { t: 0 }, { t: meta.dur, duration: meta.dur, ease: "none", immediateRender: false,
                                onUpdate: () => fn(p.t) }, 0);
      fn(0);
    },
    // seeded PRNG (mulberry32): k.rand(7)() -> [0, 1)
    rand(seed = 1) {
      let a = seed >>> 0;
      return () => { a = (a + 0x6D2B79F5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
    },
    // create an element (SVG when the parent is SVG or tag is "svg"): k.el("circle", {cx: 5, r: 3}, parent)
    el(tag, attrs = {}, parent = null) {
      const svg = tag === "svg" || (parent && parent.namespaceURI === "http://www.w3.org/2000/svg");
      const e = svg ? document.createElementNS("http://www.w3.org/2000/svg", tag) : document.createElement(tag);
      for (const [a, v] of Object.entries(attrs)) {
        if (a === "text") e.textContent = v; else if (a === "html") e.innerHTML = v; else e.setAttribute(a, v);
      }
      if (parent) parent.appendChild(e);
      return e;
    },
  };
  // a brand mascot (style mascot cast) as a rig: k.mascot("napa", {x, y, h, parent, mirror, bob})
  // .el (the wrapper), .pose("kaget", at, hold), .hide(at) / .show(at). The scene's speaker mouths
  // its narration and everyone blinks, on their own.
  k.mascot = function (name, o = {}) {
    const c = KLIP_CAST && KLIP_CAST.cast[name];
    if (!c) throw new Error(`no mascot ${name} in this style`);
    const n = ++klipMascotN, h = o.h || 300, w = h * c.aspect;
    const el = k.el("div", { class: "k-ms" }, o.parent || root.querySelector(".k-world"));
    Object.assign(el.style, { position: "absolute", left: (o.x ?? 60) + "px", top: (o.y ?? 1000) + "px",
                              width: w + "px", height: h + "px" });
    const ol = KLIP_CAST.outline;
    const body = k.el("div", { class: "k-ms-body" }, el);
    if (ol) body.style.filter = [[1, 0], [-1, 0], [0, 1], [0, -1]].map(([a, b]) =>
      `drop-shadow(${a * ol.px / 2}px ${b * ol.px / 2}px 0 ${ol.color})`).join(" ") + " drop-shadow(0 10px 10px rgba(0,0,0,.18))";
    const flip = k.el("div", { class: "k-ms-flip" + ((o.mirror ?? c.mirror) ? " mirror" : "") }, body);
    const poses = {};
    for (const [p, svg] of Object.entries(c.poses)) {
      const d = k.el("div", { class: "k-ms-pose", "data-p": p }, flip);
      d.innerHTML = svg.replace(/(id="|url\(#|href="#)ms-/g, `$1k${n}-ms-`);
      d.style.opacity = p === "netral" ? 1 : 0;
      poses[p] = d;
    }
    const all = Object.values(poses);
    const rig = {
      el, w, h, name,
      pose(p, at = 0, hold = null) {
        if (!poses[p]) throw new Error(`mascot ${name} has no pose ${p}`);
        sub.set(all, { opacity: 0 }, at); sub.set(poses[p], { opacity: 1 }, at);
        sub.fromTo(body, { scale: 0.92 }, { scale: 1, duration: 0.22, ease: "back.out(3)", immediateRender: false }, at);
        if (hold) { sub.set(all, { opacity: 0 }, at + hold); sub.set(poses.netral, { opacity: 1 }, at + hold); }
        return rig;
      },
      hide(at) { sub.set(el, { autoAlpha: 0 }, at); return rig; },
      show(at) { sub.set(el, { autoAlpha: 1 }, at); return rig; },
    };
    const mm = meta.mascots || { mouth: {}, blinks: {} };
    for (const [a, b] of mm.mouth[name] || []) {
      sub.set(el.querySelectorAll(".mouth"), { opacity: 0 }, a); sub.set(el.querySelectorAll(".mouth-open"), { opacity: 1 }, a);
      sub.set(el.querySelectorAll(".mouth"), { opacity: 1 }, b); sub.set(el.querySelectorAll(".mouth-open"), { opacity: 0 }, b);
    }
    for (const t of mm.blinks[name] || []) {
      sub.fromTo(el.querySelectorAll(".eye"), { scaleY: 1 }, { scaleY: 0.1, duration: 0.07, yoyo: true, repeat: 1,
        ease: "none", immediateRender: false, transformOrigin: "50% 50%" }, t);
    }
    if (o.bob !== false) {
      const half = KLIP_CAST.bob_s, reps = Math.max(1, Math.floor(meta.dur / half));
      sub.fromTo(body, { y: 0 }, { y: -KLIP_CAST.bob_px, duration: half, yoyo: true, repeat: reps - 1, ease: "sine.inOut" }, (n % 3) * 0.3);
    }
    return rig;
  };
  const tex = root.querySelector(".k-tex");
  if (tex && meta.texture === "grain") {           // film grain jumps 12 times a second
    k.frame((t) => { const f = Math.floor(t * 12); tex.style.backgroundPosition = `${(f * 137) % 600}px ${(f * 311) % 1020}px`; });
  }
  try {
    body(k);
  } catch (e) {
    console.error(`klip ${meta.id}:`, e);
    const box = document.createElement("div");
    box.className = "k-error";
    box.textContent = `scene ${meta.id}: ${e && e.message ? e.message : e}`;
    root.appendChild(box);
  }
}
