// ---- scene kit `k` for code scenes (contract: docs/CODE-SCENES.md)
const KLIP_LOOK = {{ code_look | tojson }};
const KLIP_KIT = {{ code.kit | tojson }};
const KLIP_CAST = {{ (code.cast or none) | tojson }};
let klipMascotN = 0;
const klipNorm = (s) => String(s).toLowerCase().replace(/[^\p{L}\p{N}_]/gu, "");
function klipScene(meta, body) {
  const root = document.getElementById("sc-" + meta.id);
  const sub = gsap.timeline();
  sub.set({}, {}, meta.dur);                       // the scene timeline spans the whole scene
  tl.add(sub, meta.start);
  const words = meta.words.map((w) => ({ ...w, n: klipNorm(w.text) }));
  const k = {
    id: meta.id, root, tl: sub, dur: meta.dur, W: 1080, H: 1920, words: meta.words, text: meta.text,
    emphasis: meta.emphasis, look: KLIP_LOOK, safe: meta.safe, lib: { THREE: window.THREE },
    $: (sel) => root.querySelector(sel),
    $$: (sel) => Array.from(root.querySelectorAll(sel)),
    // when the voice says `phrase` (scene seconds), at or after `after`
    at(phrase, after = 0) {
      const want = String(phrase).split(/\s+/).map(klipNorm).filter(Boolean);
      for (let i = 0; i + want.length <= words.length; i++) {
        if (words[i].t + 1e-3 < after) continue;
        if (want.every((w, j) => words[i + j].n === w)) return words[i].t;
      }
      console.warn(`klip ${meta.id}: k.at(${JSON.stringify(phrase)}) not in the narration`);
      return Math.min(after, meta.dur);
    },
    // fn(t) on every frame of the scene (canvas, Three.js): a pure function of scene time t
    frame(fn) {
      const p = { t: 0 };
      sub.fromTo(p, { t: 0 }, { t: meta.dur, duration: meta.dur, ease: "none", immediateRender: false,
                                onUpdate: () => fn(p.t) }, 0);
      fn(0);
    },
    // seeded PRNG (mulberry32): k.rand(7)() -> [0, 1)
    rand(seed = 1) {
      let a = seed >>> 0;
      return () => { a = (a + 0x6D2B79F5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
    },
    // create an element (SVG when the parent is SVG or tag is "svg"): k.el("circle", {cx: 5, r: 3}, parent)
    el(tag, attrs = {}, parent = null) {
      const svg = tag === "svg" || (parent && parent.namespaceURI === "http://www.w3.org/2000/svg");
      const e = svg ? document.createElementNS("http://www.w3.org/2000/svg", tag) : document.createElement(tag);
      for (const [a, v] of Object.entries(attrs)) {
        if (a === "text") e.textContent = v; else if (a === "html") e.innerHTML = v; else e.setAttribute(a, v);
      }
      if (parent) parent.appendChild(e);
      return e;
    },
  };
  // a brand mascot (style mascot cast) as a rig: k.mascot("napa", {x, y, h, parent, mirror, bob})
  // .el (the wrapper), .pose("kaget", at, hold), .hide(at) / .show(at). The scene's speaker mouths
  // its narration and everyone blinks, on their own.
  k.mascot = function (name, o = {}) {
    const c = KLIP_CAST && KLIP_CAST.cast[name];
    if (!c) throw new Error(`no mascot ${name} in this style`);
    const n = ++klipMascotN, h = o.h || 300, w = h * c.aspect;
    const el = k.el("div", { class: "k-ms" }, o.parent || root.querySelector(".k-world"));
    Object.assign(el.style, { position: "absolute", left: (o.x ?? 60) + "px", top: (o.y ?? 1000) + "px",
                              width: w + "px", height: h + "px" });
    const ol = KLIP_CAST.outline;
    const body = k.el("div", { class: "k-ms-body" }, el);
    if (ol) body.style.filter = [[1, 0], [-1, 0], [0, 1], [0, -1]].map(([a, b]) =>
      `drop-shadow(${a * ol.px / 2}px ${b * ol.px / 2}px 0 ${ol.color})`).join(" ") + " drop-shadow(0 10px 10px rgba(0,0,0,.18))";
    const flip = k.el("div", { class: "k-ms-flip" + ((o.mirror ?? c.mirror) ? " mirror" : "") }, body);
    const poses = {};
    for (const [p, svg] of Object.entries(c.poses)) {
      const d = k.el("div", { class: "k-ms-pose", "data-p": p }, flip);
      d.innerHTML = svg.replace(/(id="|url\(#|href="#)ms-/g, `$1k${n}-ms-`);
      d.style.opacity = p === "netral" ? 1 : 0;
      poses[p] = d;
    }
    const all = Object.values(poses);
    const rig = {
      el, w, h, name,
      pose(p, at = 0, hold = null) {
        if (!poses[p]) throw new Error(`mascot ${name} has no pose ${p}`);
        if (at <= 0.001) {                      // a zero-time set at the scene's start doesn't render: set it now
          gsap.set(all, { opacity: 0 }); gsap.set(poses[p], { opacity: 1 });
        } else {
          sub.set(all, { opacity: 0 }, at); sub.set(poses[p], { opacity: 1 }, at);
          sub.fromTo(body, { scale: 0.92 }, { scale: 1, duration: 0.22, ease: "back.out(3)", immediateRender: false }, at);
        }
        if (hold) { sub.set(all, { opacity: 0 }, at + hold); sub.set(poses.netral, { opacity: 1 }, at + hold); }
        return rig;
      },
      hide(at) { sub.set(el, { autoAlpha: 0 }, at); return rig; },
      show(at) { sub.set(el, { autoAlpha: 1 }, at); return rig; },
    };
    // ---- acting: whole-body moves on the scene timeline (call them in time order: walks plan from
    // where the previous one ended). Facing: +1 = toward the viewer's right, as the pose SVGs point.
    const A = KIT.act, home = o.x ?? 60;
    let at_x = home, face = (o.mirror ?? c.mirror) ? -1 : 1;
    const feet = (side) => el.querySelectorAll(`.k-foot-${side}`);
    gsap.set(el.querySelectorAll(".k-foot"), { transformOrigin: "50% 50%" });
    const faceTo = (dir, at) => {
      if (dir && dir !== face) { sub.to(flip, { scaleX: dir, duration: A.turn_s, ease: "power2.inOut" }, at); face = dir; }
    };
    Object.assign(rig, {
      get x() { return at_x; },
      // walk to x (px, the mascot's left edge) from `at`: steps with alternating feet and a body bob,
      // facing the way it goes; {dur, speed (px/s), face: false keeps the facing, back: face home after}
      walk(x, at, opt = {}) {
        const dx = x - at_x;
        if (Math.abs(dx) < 1) return rig;
        const dur = opt.dur || Math.max(0.4, Math.abs(dx) / (opt.speed || A.walk_px_s));
        const before = face;
        if (opt.face !== false) faceTo(Math.sign(dx), at);
        sub.to(el, { x: x - home, duration: dur, ease: "power1.inOut" }, at);
        sub.fromTo(body, { rotation: 0 }, { rotation: A.lean_deg * Math.sign(dx), duration: 0.18, ease: "power2.out", immediateRender: false }, at);
        sub.to(body, { rotation: 0, duration: 0.2, ease: "power2.inOut" }, at + dur - 0.1);
        const n = Math.max(2, Math.round(dur / A.step_s)), st = dur / n;
        for (let i = 0; i < n; i++) {
          const t = at + i * st;
          sub.fromTo(body, { y: 0 }, { y: -A.bob_px, duration: st / 2, yoyo: true, repeat: 1, ease: "sine.out", immediateRender: false }, t);
          sub.fromTo(feet(i % 2 ? "r" : "l"), { y: 0, rotation: 0 }, { y: -A.foot_px, rotation: -12 * face, duration: st / 2,
                      yoyo: true, repeat: 1, ease: "sine.out", immediateRender: false }, t);
        }
        at_x = x;
        if (opt.back) faceTo(before, at + dur);
        return rig;
      },
      // walk in from off-screen ("left" | "right") to its spot (or opt.x) at `at`; "bottom" = jumps up into view
      enter(from = "left", at = 0, opt = {}) {
        const to = opt.x ?? at_x;
        if (from === "bottom") {
          gsap.set(el, { y: 2 * h }); at_x = to;
          sub.to(el, { y: 0, duration: 0.45, ease: "back.out(1.6)" }, at);
          return rig;
        }
        at_x = from === "left" ? -w - 40 : 1080 + 40;
        gsap.set(el, { x: at_x - home });
        return rig.walk(to, at, { ...opt, back: opt.back ?? true });
      },
      // walk off-screen ("left" | "right") from `at`
      exit(to = "right", at = 0, opt = {}) { return rig.walk(to === "left" ? -w - 40 : 1080 + 40, at, opt); },
      // a jump with squash and stretch: {height}
      jump(at, opt = {}) {
        const hgt = opt.height || A.jump_px;
        sub.to(body, { scaleY: 0.86, scaleX: 1.08, duration: 0.08, ease: "power1.out" }, at);
        sub.to(body, { scaleY: 1.06, scaleX: 0.95, duration: 0.12, ease: "power1.out" }, at + 0.08);
        sub.to(el, { y: -hgt, duration: 0.24, ease: "power2.out" }, at + 0.08);
        sub.to(el, { y: 0, duration: 0.22, ease: "power2.in" }, at + 0.32);
        sub.to(body, { scaleY: 0.88, scaleX: 1.07, duration: 0.07, ease: "power1.out" }, at + 0.54);
        sub.to(body, { scaleY: 1, scaleX: 1, duration: 0.18, ease: "back.out(3)" }, at + 0.61);
        return rig;
      },
      // small excited hops: {times}
      hop(at, opt = {}) {
        for (let i = 0; i < (opt.times || 2); i++) {
          sub.fromTo(el, { y: 0 }, { y: -(opt.height || A.jump_px * 0.35), duration: 0.13, yoyo: true, repeat: 1,
                     ease: "power2.out", immediateRender: false }, at + i * 0.3);
        }
        return rig;
      },
      // face the viewer's left (-1) or right (+1), or the other way when dir is unset
      turn(at, dir) { faceTo(dir || -face, at); return rig; },
      // face a point (x px, or an element) and take the pointing pose: {hold, pose}
      point(target, at, opt = {}) {
        const tx = typeof target === "number" ? target : (() => { const r = one(target).getBoundingClientRect(),
          rr = root.getBoundingClientRect(); return r.left - rr.left + r.width / 2; })();
        faceTo(tx < at_x + w / 2 ? -1 : 1, at);
        const p = opt.pose || (poses.tunjuk ? "tunjuk" : "netral");
        rig.pose(p, at + 0.05, opt.hold ?? A.point_hold_s);
        sub.fromTo(body, { rotation: 0 }, { rotation: 4 * face, duration: 0.2, yoyo: true, repeat: 1,
                   repeatDelay: Math.max(0, (opt.hold ?? A.point_hold_s) - 0.4), ease: "power2.out", immediateRender: false }, at);
        return rig;
      },
      // nod (yes) twice
      nod(at) {
        sub.fromTo(body, { scaleY: 1 }, { scaleY: 0.93, duration: 0.12, yoyo: true, repeat: 3, ease: "sine.inOut",
                   immediateRender: false }, at);
        return rig;
      },
      // a side-to-side wiggle (unsure, or a little dance): {times}
      wiggle(at, opt = {}) {
        sub.fromTo(body, { rotation: 0 }, { rotation: 7, duration: 0.1, yoyo: true, repeat: (opt.times || 3) * 2 - 1,
                   ease: "sine.inOut", immediateRender: false }, at);
        return rig;
      },
    });
    const mm = meta.mascots || { mouth: {}, blinks: {} };
    for (const [a, b] of mm.mouth[name] || []) {
      sub.set(el.querySelectorAll(".mouth"), { opacity: 0 }, a); sub.set(el.querySelectorAll(".mouth-open"), { opacity: 1 }, a);
      sub.set(el.querySelectorAll(".mouth"), { opacity: 1 }, b); sub.set(el.querySelectorAll(".mouth-open"), { opacity: 0 }, b);
    }
    for (const t of mm.blinks[name] || []) {
      sub.fromTo(el.querySelectorAll(".eye"), { scaleY: 1 }, { scaleY: 0.1, duration: 0.07, yoyo: true, repeat: 1,
        ease: "none", immediateRender: false, transformOrigin: "50% 50%" }, t);
    }
    if (o.bob !== false) {
      const half = KLIP_CAST.bob_s, reps = Math.max(1, Math.floor(meta.dur / half));
      sub.fromTo(body, { y: 0 }, { y: -KLIP_CAST.bob_px, duration: half, yoyo: true, repeat: reps - 1, ease: "sine.inOut" }, (n % 3) * 0.3);
    }
    return rig;
  };
  // ---- the standard kit: layout and motion helpers, so a scene starts legible and on-brand
  const KIT = KLIP_KIT, L = meta.layout || { cast: [], scrim: {} }, P = KLIP_LOOK.palette;
  const worldEl = root.querySelector(".k-world");
  const isSvg = (el) => el instanceof SVGElement;
  const one = (x) => (typeof x === "string" ? root.querySelector(x) : x);
  k.layout = L;
  // a full-frame SVG behind the scene's HTML, with a camera group: const { svg, cam } = k.stage()
  k.stage = function (o = {}) {
    const svg = k.el("svg", { viewBox: "0 0 1080 1920", width: 1080, height: 1920, class: "k-stage" });
    Object.assign(svg.style, { position: "absolute", left: 0, top: 0 });
    worldEl.prepend(svg);
    if (o.bg !== false) k.el("rect", { width: 1080, height: 1920, fill: o.bg || P.bg }, svg);
    return { svg, cam: k.el("g", { class: "k-cam" }, svg) };
  };
  // a slow push-in over the whole scene: k.camera(cam, {to, origin: "540 760", from, at, dur})
  k.camera = function (target, o = {}) {
    const el = one(target), origin = o.origin || "540 760";
    const to = { scale: o.to ?? KIT.camera_zoom, duration: o.dur ?? k.dur - (o.at || 0), ease: o.ease || "none" };
    if (isSvg(el)) to.svgOrigin = origin; else to.transformOrigin = origin.split(" ").map((v) => v + "px").join(" ");
    sub.fromTo(el, { scale: o.from ?? 1 }, to, o.at || 0);
    return el;
  };
  // a band of the look's bg behind the headline ("top") or the mascots and captions ("bottom")
  k.scrim = function (where = "top", o = {}) {
    const top = where === "top", c = o.color || P.bg, s = L.scrim || {};
    const el = k.el("div", { class: "k-scrim" }, worldEl);
    Object.assign(el.style, { position: "absolute", left: 0, right: 0, zIndex: 2, pointerEvents: "none",
      top: (top ? 0 : o.from ?? s.bottomFrom) + "px", height: (top ? o.height ?? s.top : o.height ?? s.bottom) + "px",
      background: top ? `linear-gradient(180deg, ${c} 0%, ${c}E6 45%, ${c}00 100%)`
                      : `linear-gradient(0deg, ${c} 0%, ${c}F0 50%, ${c}00 100%)` });
    return el;
  };
  // the scene's headline (on_screen_text by default) below the series pill; emphasis and ALL-CAPS
  // words in the accent; pops in word by word at `at`. k.headline({text, size, top, at, align, scrim})
  k.headline = function (o = {}) {
    const h = KIT.headline;
    if (o.scrim !== false) k.scrim("top");
    const el = k.el("div", { class: "k-headline" }, worldEl);
    const emph = (o.emphasis || k.emphasis || []).join(" ").split(/\s+/).map(klipNorm).filter(Boolean);
    for (const w of String(o.text ?? k.text).split(/\s+/).filter(Boolean)) {
      const caps = w === w.toUpperCase() && /\p{L}/u.test(w);
      const s = k.el("span", { class: "k-hw", text: w }, el);
      if (caps || emph.includes(klipNorm(w))) s.style.color = o.accent || P.accent;
      el.append(" ");
    }
    Object.assign(el.style, { position: "absolute", left: k.safe.x + "px", width: k.safe.w + "px", zIndex: 4,
      top: (o.top ?? L.headlineTop ?? h.top) + "px", textAlign: o.align || "left", color: o.color || P.ink,
      font: `800 ${o.size || (meta.hook ? h.hook_size : h.size)}px/${h.line_height} var(--k-display)`,
      letterSpacing: "-0.02em", textShadow: `0 6px 0 ${P.bg}, 0 14px 30px rgba(0,0,0,.45)` });
    if (o.at !== false) sub.from(el.querySelectorAll(".k-hw"), { y: 40, opacity: 0, duration: 0.3, stagger: h.stagger_s,
                                                                 ease: KLIP_LOOK.ease.out }, o.at ?? 0.05);
    return el;
  };
  // the style's mascots at their usual spots (as on stage scenes), over a bottom scrim: k.cast() -> {napa, gulung}
  k.cast = function (o = {}) {
    if (o.scrim !== false && L.cast.length) k.scrim("bottom");
    const out = {};
    for (const m of L.cast) {
      if (o.only && !o.only.includes(m.name)) continue;
      const r = k.mascot(m.name, { x: m.x, y: m.y, h: m.h, parent: worldEl });
      r.el.style.zIndex = 3;
      out[m.name] = r;
    }
    return out;
  };
  // a label chip: k.chip("KASIR", x, y, {bg, color, size, rot, at}) pops in at `at`
  k.chip = function (text, x, y, o = {}) {
    const el = k.el("div", { class: "k-chip", text }, o.parent || worldEl);
    Object.assign(el.style, { position: "absolute", left: x + "px", top: y + "px", padding: "10px 26px 14px", zIndex: 3,
      borderRadius: "16px", background: o.bg || P.ink, color: o.color || P.bg, whiteSpace: "nowrap",
      font: `800 ${o.size || KIT.chip.size}px/1.1 var(--k-display)`, boxShadow: "0 14px 30px rgba(0,0,0,.35)",
      transform: `rotate(${o.rot || 0}deg)` });
    if (o.at != null) k.pop(el, o.at);
    return el;
  };
  // pop in (scale from 0 with the look's pop ease)
  k.pop = function (target, at, o = {}) {
    const el = one(target);
    const from = { scale: 0, rotation: o.rot ?? 0 };
    if (isSvg(el)) from.transformOrigin = "50% 50%";
    sub.from(el, { ...from, duration: o.dur || 0.35, ease: KLIP_LOOK.ease.pop }, at);
    return el;
  };
  // shake: k.shake(el, at, {px, times})
  k.shake = function (target, at, o = {}) {
    sub.fromTo(one(target), { x: 0 }, { x: o.px || 10, duration: 0.05, yoyo: true, repeat: (o.times || 3) * 2 - 1,
                                       ease: "none", immediateRender: false }, at);
  };
  // typewriter: the element's text types out from `at` (cps characters a second)
  k.type = function (target, at, o = {}) {
    const el = one(target), full = o.text ?? el.textContent, cps = o.cps || KIT.type_cps;
    k.frame((t) => { el.textContent = full.slice(0, Math.max(0, Math.min(full.length, Math.floor((t - at) * cps)))); });
    return el;
  };
  // a number counting up from `at`: k.count(el, {to, from, at, dur, decimals, prefix, suffix}), Indonesian format
  k.count = function (target, o = {}) {
    const el = one(target), from = o.from || 0, at = o.at || 0, dur = o.dur || KIT.count_s, ease = gsap.parseEase("power2.out");
    const fmt = (v) => {
      const [whole, frac] = Math.abs(v).toFixed(o.decimals || 0).split(".");
      return (o.prefix || "") + (v < 0 ? "-" : "") + whole.replace(/\B(?=(\d{3})+(?!\d))/g, ".") + (frac ? "," + frac : "") + (o.suffix || "");
    };
    k.frame((t) => { el.textContent = fmt(from + (o.to - from) * ease(Math.max(0, Math.min(1, (t - at) / dur)))); });
    return el;
  };
  // draw an SVG path / line / shape's stroke on from `at`
  k.draw = function (target, at, o = {}) {
    const el = one(target), len = el.getTotalLength ? el.getTotalLength() : 1000;
    gsap.set(el, { strokeDasharray: len, strokeDashoffset: len });
    sub.to(el, { strokeDashoffset: 0, duration: o.dur || 0.8, ease: o.ease || KLIP_LOOK.ease.out }, at);
    return el;
  };
  const tex = root.querySelector(".k-tex");
  if (tex && meta.texture === "grain") {           // film grain jumps 12 times a second
    k.frame((t) => { const f = Math.floor(t * 12); tex.style.backgroundPosition = `${(f * 137) % 600}px ${(f * 311) % 1020}px`; });
  }
  try {
    body(k);
  } catch (e) {
    console.error(`klip ${meta.id}:`, e);
    const box = document.createElement("div");
    box.className = "k-error";
    box.textContent = `scene ${meta.id}: ${e && e.message ? e.message : e}`;
    root.appendChild(box);
  }
}
