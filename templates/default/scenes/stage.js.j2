{% set st = s.stage %}
{% set c = stage.cfg %}
// stage: the background stays across a run of stage scenes (it pans slowly), props build up on it
{% if not st.continues %}
tl.fromTo("#sc-{{ s.id }} .stage-bg", { scale: {{ 1.12 if style.transition == "punch" else 1 }} }, { scale: 1, duration: 0.35, ease: "power2.out" }, {{ s.start }});
{% endif %}
tl.fromTo("#sc-{{ s.id }} .stage-pan", { x: {{ st.bg_from }} }, { x: {{ st.bg_to }}, duration: {{ s.dur }}, ease: "none", immediateRender: false }, {{ s.start }});
// camera: a slow push-in, and on each entry a small move toward the props on stage
tl.fromTo("#sc-{{ s.id }} .st-cam", { scale: 1 }, { scale: {{ c.zoom }}, duration: {{ s.dur }}, ease: "none", immediateRender: false }, {{ s.start }});
{% if st.camera %}
gsap.set("#sc-{{ s.id }} .st-cam", { x: 0, y: 0 });
{% for k in st.camera %}
tl.to("#sc-{{ s.id }} .st-cam", { x: {{ k.x }}, y: {{ k.y }}, duration: {{ k.dur }}, ease: "power2.inOut" }, {{ k.t }});
{% endfor %}
{% endif %}
// depth: the set follows the camera at a fraction of its moves (parallax), the bokeh in front faster
{% set dp = st.depth %}
{% if dp.bg %}
tl.fromTo("#sc-{{ s.id }} .stage-pan", { scale: 1 }, { scale: {{ (1 + (c.zoom - 1) * dp.bg) | round(4) }}, duration: {{ s.dur }}, ease: "none", immediateRender: false }, {{ s.start }});
{% endif %}
{% if dp.fg %}
tl.fromTo("#sc-{{ s.id }} .st-fg", { scale: 1 }, { scale: {{ (1 + (c.zoom - 1) * dp.fgf) | round(4) }}, duration: {{ s.dur }}, ease: "none", immediateRender: false }, {{ s.start }});
{% for b in dp.fg %}
tl.fromTo("#sc-{{ s.id }} .st-fg i:nth-child({{ loop.index }})", { x: 0 }, { x: {{ b.dx }}, duration: {{ s.dur }}, ease: "none", immediateRender: false }, {{ s.start }});
{% endfor %}
{% endif %}
{% if st.camera %}
gsap.set("#sc-{{ s.id }} .stage-bg", { x: 0, y: 0 });
{% for k in st.camera %}
{% if dp.bg %}tl.to("#sc-{{ s.id }} .stage-bg", { x: {{ (k.x * dp.bg) | round(1) }}, y: {{ (k.y * dp.bg) | round(1) }}, duration: {{ k.dur }}, ease: "power2.inOut" }, {{ k.t }});{% endif %}
{% if dp.fg %}tl.to("#sc-{{ s.id }} .st-fg", { x: {{ (k.x * dp.fgf) | round(1) }}, y: {{ (k.y * dp.fgf) | round(1) }}, duration: {{ k.dur }}, ease: "power2.inOut" }, {{ k.t }});{% endif %}
{% endfor %}
{% endif %}
{% if dp.dof %}
// depth of field: the photo set goes soft once the props are on
{% if st.continues %}tl.set("#sc-{{ s.id }} .stage-pan", { filter: "blur({{ dp.dof.px }}px)" }, {{ s.start }});
{% else %}tl.fromTo("#sc-{{ s.id }} .stage-pan", { filter: "blur(0px)" }, { filter: "blur({{ dp.dof.px }}px)", duration: 0.5, ease: "power2.inOut", immediateRender: false }, {{ dp.dof.t }});{% endif %}
{% endif %}
{% if st.title or st.list_no %}
gsap.set("#sc-{{ s.id }} .st-title", { rotation: {{ 0 if st.title_style == "plain" else c.title.tilt_deg }} });
{% if s.idx == 0 %}
tl.fromTo("#sc-{{ s.id }} .st-title", { scale: {{ style.headline.hook_punch }} }, { scale: 1, duration: 0.3, ease: "back.out(2.2)" }, {{ s.start }});
{% else %}
tl.fromTo("#sc-{{ s.id }} .st-title", { y: -60, opacity: 0 }, { y: 0, opacity: 1, duration: 0.3, ease: "power3.out" }, {{ s.start }});
{% endif %}
{% set ty = c.motion.title %}
// kinetic title: words in one by one; keywords slam in (pulse on the hook) when the voice says them
(function () {
  const ws = document.querySelectorAll("#sc-{{ s.id }} .st-title .hw"), row = document.querySelector("#sc-{{ s.id }} .st-title-row");
{% set ns = namespace(k=0) %}
{% for h in st.title %}
{% set late = h.slam is not none and h.slam > s.start + 0.3 and h.slam < s.start + s.dur - 0.4 %}
{% if s.idx == 0 %}
{% if h.key and late %}
  tl.fromTo(ws[{{ loop.index0 }}], { scale: {{ ty.pulse_scale }} }, { scale: 1, duration: 0.32, ease: "back.out(3)", immediateRender: false }, {{ h.slam }});
{% if ty.shine %}  klipFx.shine(tl, ws[{{ loop.index0 }}], {{ h.slam }});{% endif %}
  klipFx.shake(tl, row, {{ h.slam }}, { px: {{ ty.shake_px }}, times: 2 });
{% endif %}
{% elif h.key and late %}
  tl.fromTo(ws[{{ loop.index0 }}], { scale: {{ ty.slam_scale }}, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.2, ease: "power4.in" }, {{ (h.slam - 0.2) | round(3) }});
{% if ty.shine %}  klipFx.shine(tl, ws[{{ loop.index0 }}], {{ h.slam }});{% endif %}
  klipFx.shake(tl, row, {{ h.slam }}, { px: {{ ty.shake_px }}, times: 2 });
{% else %}
  tl.fromTo(ws[{{ loop.index0 }}], { y: 36, opacity: 0, filter: "blur(8px)" }, { y: 0, opacity: 1, filter: "blur(0px)", duration: 0.28, ease: "power3.out" }, {{ (s.start + 0.08 + ns.k * ty.stagger_s) | round(3) }});
{% if h.key and ty.shine %}  klipFx.shine(tl, ws[{{ loop.index0 }}], {{ (s.start + 0.45 + ns.k * ty.stagger_s) | round(3) }});{% endif %}
{% set ns.k = ns.k + 1 %}
{% endif %}
{% endfor %}
})();
{% endif %}
{% for e in st.elements %}
{% set sel = "#" ~ e.id %}
gsap.set("{{ sel }}", { rotation: {{ e.rot }} });
{% if e.enter == "slide" %}
tl.fromTo("{{ sel }}", { x: {{ -760 if e.col == "l" else 760 }}, rotation: {{ e.rot + (-12 if e.col == "l" else 12) }} }, { x: 0, rotation: {{ e.rot }}, duration: 0.46, ease: "back.out(1.2)" }, {{ e.start }});
{% elif e.enter == "drop" %}
// cut-out: dropped onto the desk, lands with a little squash
tl.fromTo("{{ sel }}", { y: -140, scale: 1.18, rotation: {{ e.rot - 9 }}, opacity: 0 }, { y: 0, scale: 1, rotation: {{ e.rot }}, opacity: 1, duration: 0.36, ease: "power3.in" }, {{ e.start }});
tl.fromTo("{{ sel }} > .st-in", { scaleX: 1, scaleY: 1, transformOrigin: "50% 100%" }, { scaleX: 1.05, scaleY: 0.93, duration: 0.07, yoyo: true, repeat: 1, ease: "sine.out", immediateRender: false }, {{ (e.start + 0.36) | round(3) }});
{% elif e.enter == "toss" %}
// card: tossed in from below, spinning down to its tilt
tl.fromTo("{{ sel }}", { y: 320, scale: 0.82, rotation: {{ e.rot + 16 }}, opacity: 0 }, { y: 0, scale: 1, rotation: {{ e.rot }}, opacity: 1, duration: 0.5, ease: "back.out(1.5)" }, {{ e.start }});
{% elif e.enter == "notify" %}
// phone notification: slides down from the top of the screen and settles
tl.fromTo("{{ sel }}", { y: -220, scale: 0.94, opacity: 0 }, { y: 0, scale: 1, opacity: 1, duration: 0.42, ease: "back.out(1.3)" }, {{ e.start }});
{% elif e.comp is defined %}
{% include "scenes/components.js.j2" %}
{% elif e.kind == "icon" %}
tl.fromTo("{{ sel }}", { scale: 0, rotation: {{ e.rot - 25 }} }, { scale: 1, rotation: {{ e.rot }}, duration: 0.4, ease: "back.out(2.2)" }, {{ e.start }});
{% elif e.kind == "label" %}
tl.fromTo("{{ sel }}", { x: -40, opacity: 0 }, { x: 0, opacity: 1, duration: 0.24, ease: "power3.out" }, {{ e.start }});
tl.fromTo("{{ sel }} .st-tag", { clipPath: "inset(0% 100% 0% 0%)" }, { clipPath: "inset(0% 0% 0% 0%)", duration: 0.28, ease: "power3.out" }, {{ e.start }});
{% elif e.kind == "number" %}
tl.fromTo("{{ sel }}", { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.45, ease: "back.out(2.6)" }, {{ e.start }});
{% if e.count %}
(() => {
  const el = document.querySelector("{{ sel }} .st-num");
  const n = { v: 0 };
  const fmt = (v) => {
    const [whole, frac] = Math.abs(v).toFixed({{ e.count.decimals }}).split(".");
    return {{ e.count.prefix | tojson }} + whole.replace(/\B(?=(\d{3})+(?!\d))/g, ".") + (frac ? "," + frac : "") + {{ e.count.suffix | tojson }};
  };
  tl.fromTo(n, { v: 0 }, { v: {{ e.count.value }}, duration: {{ c.motion.count_s }}, ease: "power2.out",
    onUpdate: () => { el.textContent = fmt(n.v); } }, {{ e.start }});
})();
{% endif %}
{% elif e.kind == "bar" %}
tl.fromTo("{{ sel }}", { scale: 0.6, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: "back.out(1.8)" }, {{ e.start }});
tl.fromTo("{{ sel }} .st-bar", { scaleY: 0 }, { scaleY: 1, duration: 0.45, stagger: 0.12, ease: "power2.out" }, {{ (e.start + 0.15) | round(3) }});
{% elif e.kind == "stack" %}
tl.fromTo("{{ sel }} .st-coin", { y: -260, opacity: 0 }, { y: 0, opacity: 1, duration: 0.3, stagger: 0.09, ease: "back.out(1.6)" }, {{ e.start }});
{% elif e.kind == "chart" %}
tl.fromTo("{{ sel }}", { scale: 0.7, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: "back.out(1.6)" }, {{ e.start }});
tl.fromTo("{{ sel }} .lc-band", { opacity: 0 }, { opacity: 1, duration: 0.3, stagger: 0.15, ease: "none" }, {{ (e.start + 0.2) | round(3) }});
tl.fromTo("{{ sel }} .lc-line", { strokeDashoffset: {{ e.chart.len }} }, { strokeDashoffset: 0, duration: {{ c.chart.draw_s }}, ease: "power1.inOut" }, {{ (e.start + 0.25) | round(3) }});
tl.fromTo("{{ sel }} .lc-area", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "none" }, {{ (e.start + 0.25 + c.chart.draw_s * 0.6) | round(3) }});
tl.fromTo("{{ sel }} .lc-dot, {{ sel }} .lc-last", { scale: 0, opacity: 0, transformOrigin: "50% 50%" }, { scale: 1, opacity: 1, duration: 0.3, ease: "back.out(2.4)" }, {{ (e.start + 0.25 + c.chart.draw_s) | round(3) }});
{% elif e.kind == "unit" %}
tl.fromTo("{{ sel }}", { opacity: 0 }, { opacity: 1, duration: 0.15, ease: "none" }, {{ e.start }});
tl.fromTo("{{ sel }} .un-grid i", { scale: 0 }, { scale: 1, duration: 0.18, stagger: {{ (c.unit.fill_s / [e.unit.total, 1] | max) | round(4) }}, ease: "back.out(2)" }, {{ e.start }});
{% if e.text %}tl.fromTo("{{ sel }} .un-legend", { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.25, ease: "power2.out" }, {{ (e.start + 0.3) | round(3) }});{% endif %}
{% elif e.kind == "stamp" %}
tl.fromTo("{{ sel }}", { scale: 2.4, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.18, ease: "power3.in" }, {{ e.start }});
tl.fromTo("#sc-{{ s.id }} .st-props", { y: 0 }, { y: 7, duration: 0.05, yoyo: true, repeat: 3, ease: "sine.inOut", immediateRender: false }, {{ (e.start + 0.18) | round(3) }});
{% if fx.stamp %}
(function () {
  const el = document.querySelector("{{ sel }}"), x = el.offsetWidth / 2, y = el.offsetHeight / 2;
  const col = getComputedStyle(el.querySelector(".st-stamp-in") || el).color;      // the stamp's ink
  klipFx.shock(tl, el, x, y, {{ (e.start + 0.18) | round(3) }}, { color: col, behind: true });
  klipFx.sparks(tl, el, x, y, {{ (e.start + 0.18) | round(3) }}, { color: col, behind: true });
})();
{% endif %}
{% elif e.kind == "highlight" %}
tl.fromTo("{{ sel }} .st-hl", { clipPath: "inset(0% 100% 0% 0%)" }, { clipPath: "inset(0% 0% 0% 0%)", duration: 0.35, ease: "power2.inOut" }, {{ e.start }});
{% endif %}
{% if e.label_font %}
tl.fromTo("{{ sel }} .st-subrow .st-tag", { scale: 1.6, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.2, ease: "power4.out" }, {{ (e.start + 0.18) | round(3) }});
{% endif %}
{% set fl = c.motion.feel %}
{% set entry = {"slide": [0.46, 0.3], "drop": [0.36, 0.36], "toss": [0.5, 0.26], "notify": [0.42, 0.24]}.get(e.enter) %}
{% if e.kind == "stamp" %}{% set entry = [0.18, 0.18] %}{% endif %}
{% if entry %}
{% if fl.entry_blur_px %}
tl.fromTo("{{ sel }}", { filter: "blur({{ fl.entry_blur_px }}px)" }, { filter: "blur(0px)", duration: {{ (entry[0] * 0.75) | round(3) }}, ease: "power2.in", immediateRender: false }, {{ e.start }});
{% endif %}
{% if fl.jelly_deg and e.kind != "stamp" %}
tl.fromTo("{{ sel }} > .st-in", { skewX: {{ fl.jelly_deg if e.i % 2 else -fl.jelly_deg }} }, { skewX: 0, duration: 0.7, ease: "elastic.out(1, 0.3)", immediateRender: false }, {{ (e.start + entry[1]) | round(3) }});
{% endif %}
{% if fl.dust and (e.enter == "drop" or e.kind == "stamp") %}
(function () {
  const host = document.querySelector("{{ sel }}");
  for (let i = 0; i < {{ fl.dust }}; i++) {
    const d = document.createElement("i"); d.className = "st-dust"; host.appendChild(d);
    const a = Math.PI * (0.08 + 0.84 * i / {{ fl.dust - 1 }}), r = 110 + 70 * Math.abs(Math.sin(i * 2.3 + {{ e.i }}));
    tl.fromTo(d, { x: 0, y: 0, scale: 0.35, opacity: 0.85 }, { x: -Math.cos(a) * r * 1.6, y: -Math.sin(a) * r * 0.45,
               scale: 1.25, opacity: 0, duration: 0.55, ease: "power2.out", immediateRender: false }, {{ (e.start + entry[1]) | round(3) }});
  }
})();
{% endif %}
{% endif %}
{% if e.float %}
tl.fromTo("{{ sel }} > .st-in", { y: 0, rotation: 0 }, { y: {{ e.float.y }}, rotation: {{ e.float.rot }}, duration: {{ e.float.half }}, yoyo: true, repeat: {{ e.float.repeat }}, ease: "sine.inOut", immediateRender: false }, {{ e.float.t }});
{% endif %}
{% if e.exit is not none %}
{% if e.exit_to %}
{% if c.motion.feel.anticipate_px and e.exit - 0.1 > e.start + 0.5 %}
tl.to("{{ sel }}", { x: {{ -c.motion.feel.anticipate_px if e.exit_to.x > 0 else c.motion.feel.anticipate_px }}, duration: 0.1, ease: "power2.out" }, {{ (e.exit - 0.1) | round(3) }});
{% endif %}
tl.to("{{ sel }}", { x: {{ e.exit_to.x }}, rotation: {{ e.rot + e.exit_to.rot }}, opacity: 0, duration: {{ c.exit_s }}, ease: "power3.in" }, {{ e.exit }});
{% else %}
tl.to("{{ sel }}", { opacity: 0, scale: 0.85, y: 40, duration: {{ c.exit_s }}, ease: "power2.in" }, {{ e.exit }});
{% endif %}
{% endif %}
{% endfor %}
