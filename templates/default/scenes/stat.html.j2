    <div class="statrow" style="top: 430px;">{% if s.t.prefix %}<span class="pre">{{ s.t.prefix }}</span>{% endif %}<span class="num" id="num-{{ s.id }}" style="font-size: {{ s.t.font_size }}px;">{{ s.t.zero }}</span>{% if s.t.suffix %}<span class="suf{{ ' spaced' if s.t.suffix.startswith(' ') }}">{{ s.t.suffix.strip() }}</span>{% endif %}</div>
    {% if s.t.label %}<div class="safe headline" style="top: 800px; font-size: 76px;"><span>{% for h in s.t.label %}<span class="hw{{ ' emph' if h.emph }}">{{ h.text }}</span>{{ ' ' if not loop.last }}{% endfor %}</span></div>{% endif %}
