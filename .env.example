# Stock media (all optional). Without keys Klip still uses assets/broll/ and Openverse photos.
# Pixabay: free key at https://pixabay.com/api/docs/ (videos + photos)
PIXABAY_API_KEY=
# Pexels: https://www.pexels.com/api/ (new keys paused as of Oct 2026; used automatically if set)
PEXELS_API_KEY=
# Unsplash (stage prop photos): free access key at https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# Standalone script writing (klip new) with an OpenAI-compatible endpoint (llm.provider: openai).
# Not needed for the Claude Code CLI provider (it uses your Claude login).
# e.g. Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:14b
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Natural voices (optional; klip.yaml voices.engine). Compare: uv run klip ab-voice <spec>
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys (10k characters/month free)
ELEVENLABS_API_KEY=
# Gemini TTS: https://aistudio.google.com/apikey (word timings need: uv sync --extra align)
GEMINI_API_KEY=

# Phase 6 (optional AI images)
HF_TOKEN=

# Optional: path to a Node >= 22 binary if `node` on PATH is older.
# KLIP_NODE=/Users/you/.nvm/versions/node/v22.x.x/bin/node
